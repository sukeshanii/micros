---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout title="Contact Us — Micro & Calorie Tracker">
  <Navbar />

  <main class="max-w-[800px] mx-auto px-6 py-10">
    <div class="mb-8">
      <p class="text-[12px] font-mono text-[#888888] uppercase tracking-wide mb-1">Contact</p>
      <h1 class="text-[32px] font-semibold tracking-[-1.28px] text-[#171717]">Contact Us.</h1>
      <p class="text-[15px] text-[#4d4d4d] mt-1">Have a question, suggestion, or feedback? We would love to hear from you.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      <div class="space-y-5">
        <div class="rounded-[12px] bg-[#fafafa] border border-[#ebebeb] p-5">
          <h2 class="text-[14px] font-semibold text-[#171717] mb-2">Email</h2>
          <p class="text-[14px] text-[#4d4d4d]">hello@microcalorietracker.com</p>
        </div>
        <div class="rounded-[12px] bg-[#fafafa] border border-[#ebebeb] p-5">
          <h2 class="text-[14px] font-semibold text-[#171717] mb-2">Response Time</h2>
          <p class="text-[14px] text-[#4d4d4d]">We typically respond within 24–48 hours during business days.</p>
        </div>
        <div class="rounded-[12px] bg-[#fafafa] border border-[#ebebeb] p-5">
          <h2 class="text-[14px] font-semibold text-[#171717] mb-2">Feedback</h2>
          <p class="text-[14px] text-[#4d4d4d]">Your feedback helps us improve. If you have feature requests or bug reports, we are eager to hear them.</p>
        </div>
      </div>

      <form id="contact-form" class="space-y-4">
        <div>
          <label for="name" class="block text-[13px] font-medium text-[#171717] mb-1.5">Name</label>
          <input type="text" id="name" placeholder="Your name" class="w-full h-10 px-3 rounded-[6px] border border-[#ebebeb] bg-white text-[14px] text-[#171717] placeholder:text-[#888888] focus:outline-none focus:border-[#a1a1a1] transition-colors" required />
        </div>
        <div>
          <label for="email" class="block text-[13px] font-medium text-[#171717] mb-1.5">Email</label>
          <input type="email" id="email" placeholder="you@example.com" class="w-full h-10 px-3 rounded-[6px] border border-[#ebebeb] bg-white text-[14px] text-[#171717] placeholder:text-[#888888] focus:outline-none focus:border-[#a1a1a1] transition-colors" required />
        </div>
        <div>
          <label for="message" class="block text-[13px] font-medium text-[#171717] mb-1.5">Message</label>
          <textarea id="message" rows="5" placeholder="How can we help?" class="w-full px-3 py-2.5 rounded-[6px] border border-[#ebebeb] bg-white text-[14px] text-[#171717] placeholder:text-[#888888] focus:outline-none focus:border-[#a1a1a1] transition-colors resize-y" required></textarea>
        </div>
        <button type="submit" id="contact-submit" class="w-full h-11 rounded-[6px] bg-[#171717] text-white text-[15px] font-medium hover:bg-[#333] transition-colors">Send message</button>
        <p id="contact-status" class="text-[13px] font-mono hidden"></p>
      </form>
      <script>
        document.getElementById('contact-form')!.addEventListener('submit', async (e) => {
          e.preventDefault();
          const btn = document.getElementById('contact-submit') as HTMLButtonElement;
          const status = document.getElementById('contact-status')!;
          btn.disabled = true; btn.textContent = 'Sending...';
          try {
            const res = await fetch('/api/contact', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                name: (document.getElementById('name') as HTMLInputElement).value,
                email: (document.getElementById('email') as HTMLInputElement).value,
                message: (document.getElementById('message') as HTMLTextAreaElement).value,
              }),
            });
            if (res.ok) {
              status.textContent = '✓ Message sent! We\'ll get back to you soon.';
              status.className = 'text-[13px] font-mono text-[#10b981]';
              (document.getElementById('contact-form') as HTMLFormElement).reset();
            } else {
              const data = await res.json();
              status.textContent = data.error || 'Failed to send. Try again.';
              status.className = 'text-[13px] font-mono text-[#ee0000]';
            }
          } catch {
            status.textContent = 'Network error. Check your connection.';
            status.className = 'text-[13px] font-mono text-[#ee0000]';
          }
          status.classList.remove('hidden');
          btn.disabled = false; btn.textContent = 'Send message';
        });
      </script>
    </div>
  </main>
</Layout>
