---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout title="Dashboard — Micro & Calorie Tracker">
  <Navbar currentPage="/dashboard" />

  <main class="max-w-[1400px] mx-auto px-6 py-10">

    <div class="mb-8">
      <p class="text-[12px] font-mono text-[#888888] uppercase tracking-wide mb-1">Overview</p>
      <h1 class="text-[32px] font-semibold tracking-[-1.28px] text-[#171717]">Your nutrition dashboard.</h1>
      <p class="text-[15px] text-[#4d4d4d] mt-1">Track your daily intake, progress, and weekly trends.</p>
    </div>

    <!-- Today summary cards (API-backed) -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-8" id="summary-cards">
      <div class="rounded-[12px] bg-white border border-[#ebebeb] p-5 shadow-card">
        <p class="text-[12px] font-mono text-[#888888] uppercase tracking-wide mb-1">Calories today</p>
        <div class="flex items-end gap-1">
          <span id="sc-cal-val" class="text-[28px] font-semibold tracking-[-1px] text-[#171717]">—</span>
          <span class="text-[13px] text-[#888888] mb-1">/ <span id="sc-cal-goal">2000</span> kcal</span>
        </div>
        <div class="mt-2 h-2 rounded-full bg-[#ebebeb] overflow-hidden">
          <div id="sc-cal-bar" class="h-full rounded-full bg-[#171717] transition-all duration-700" style="width:0%"></div>
        </div>
        <p id="sc-cal-pct" class="text-[11px] text-[#888888] mt-1">0%</p>
      </div>
      <div class="rounded-[12px] bg-white border border-[#ebebeb] p-5 shadow-card">
        <p class="text-[12px] font-mono text-[#888888] uppercase tracking-wide mb-1">Protein</p>
        <div class="flex items-end gap-1">
          <span id="sc-pro-val" class="text-[28px] font-semibold tracking-[-1px] text-[#171717]">—</span>
          <span class="text-[13px] text-[#888888] mb-1">/ <span id="sc-pro-goal">100</span> g</span>
        </div>
        <div class="mt-2 h-2 rounded-full bg-[#ebebeb] overflow-hidden">
          <div id="sc-pro-bar" class="h-full rounded-full bg-[#3b82f6] transition-all duration-700" style="width:0%"></div>
        </div>
        <p id="sc-pro-pct" class="text-[11px] text-[#888888] mt-1">0%</p>
      </div>
      <div class="rounded-[12px] bg-white border border-[#ebebeb] p-5 shadow-card">
        <p class="text-[12px] font-mono text-[#888888] uppercase tracking-wide mb-1">Carbs</p>
        <div class="flex items-end gap-1">
          <span id="sc-carb-val" class="text-[28px] font-semibold tracking-[-1px] text-[#171717]">—</span>
          <span class="text-[13px] text-[#888888] mb-1">/ <span id="sc-carb-goal">250</span> g</span>
        </div>
        <div class="mt-2 h-2 rounded-full bg-[#ebebeb] overflow-hidden">
          <div id="sc-carb-bar" class="h-full rounded-full bg-[#f59e0b] transition-all duration-700" style="width:0%"></div>
        </div>
        <p id="sc-carb-pct" class="text-[11px] text-[#888888] mt-1">0%</p>
      </div>
      <div class="rounded-[12px] bg-white border border-[#ebebeb] p-5 shadow-card">
        <p class="text-[12px] font-mono text-[#888888] uppercase tracking-wide mb-1">Fat</p>
        <div class="flex items-end gap-1">
          <span id="sc-fat-val" class="text-[28px] font-semibold tracking-[-1px] text-[#171717]">—</span>
          <span class="text-[13px] text-[#888888] mb-1">/ <span id="sc-fat-goal">65</span> g</span>
        </div>
        <div class="mt-2 h-2 rounded-full bg-[#ebebeb] overflow-hidden">
          <div id="sc-fat-bar" class="h-full rounded-full bg-[#ef4444] transition-all duration-700" style="width:0%"></div>
        </div>
        <p id="sc-fat-pct" class="text-[11px] text-[#888888] mt-1">0%</p>
      </div>
      <div class="rounded-[12px] bg-white border border-[#ebebeb] p-5 shadow-card">
        <p class="text-[12px] font-mono text-[#888888] uppercase tracking-wide mb-1">Meals Logged</p>
        <div class="flex items-end gap-1">
          <span id="sc-meals-val" class="text-[28px] font-semibold tracking-[-1px] text-[#171717]">—</span>
          <span class="text-[13px] text-[#888888] mb-1">/ <span id="sc-meals-goal">3</span></span>
        </div>
        <div class="mt-2 h-2 rounded-full bg-[#ebebeb] overflow-hidden">
          <div id="sc-meals-bar" class="h-full rounded-full bg-[#50e3c2] transition-all duration-700" style="width:0%"></div>
        </div>
        <p id="sc-meals-pct" class="text-[11px] text-[#888888] mt-1">0 meals</p>
      </div>
    </div>

    <!-- Goal weight progress banner -->
    <div id="goal-weight-banner" class="hidden rounded-[12px] bg-white border border-[#ebebeb] p-5 shadow-card mb-6">
      <div class="flex items-center justify-between gap-4 flex-wrap">
        <div>
          <p class="text-[12px] font-mono text-[#888888] uppercase tracking-wide mb-1">Weight goal progress</p>
          <div class="flex items-baseline gap-2">
            <span id="gw-current" class="text-[28px] font-semibold tracking-[-1px] text-[#171717]">—</span>
            <span class="text-[13px] text-[#888888]">kg current</span>
            <span class="text-[20px] text-[#ebebeb] mx-1">→</span>
            <span id="gw-target" class="text-[20px] font-semibold tracking-[-0.6px] text-[#0070f3]">—</span>
            <span class="text-[13px] text-[#888888]">kg target</span>
          </div>
        </div>
        <div class="flex-1 min-w-[200px]">
          <div class="flex justify-between text-[12px] font-mono text-[#888888] mb-1.5">
            <span id="gw-remaining">— kg to go</span>
            <span id="gw-pct">0%</span>
          </div>
          <div class="h-2 rounded-full bg-[#ebebeb] overflow-hidden">
            <div id="gw-bar" class="h-full rounded-full bg-[#0070f3] transition-all duration-700" style="width:0%"></div>
          </div>
          <p id="gw-eta" class="text-[11px] font-mono text-[#888888] mt-1.5"></p>
        </div>
        <a href="/profile" class="px-4 h-9 rounded-full border border-[#ebebeb] text-[13px] font-medium text-[#171717] hover:bg-[#fafafa] transition-colors flex items-center shrink-0">
          Update weight
        </a>
      </div>
    </div>

    <!-- Remaining today -->
    <div id="remaining-banner" class="hidden rounded-[12px] bg-[#171717] p-5 shadow-card-lg mb-6">
      <div class="flex items-center gap-2 mb-4">
        <div class="w-5 h-5 rounded-full bg-[#50e3c2] flex items-center justify-center">
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
            <path d="M2 5l2 2 4-4" stroke="#171717" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <p class="text-[12px] font-mono text-[#50e3c2] uppercase tracking-wide">Remaining today</p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4" id="remaining-grid"><!-- JS --></div>
    </div>

    <div class="grid lg:grid-cols-3 gap-6">

      <!-- Weekly chart (left 2 cols) -->
      <div class="lg:col-span-2 rounded-[12px] bg-white border border-[#ebebeb] p-6 shadow-card">
        <div class="flex items-center justify-between mb-6">
          <div>
            <p class="text-[12px] font-mono text-[#888888] uppercase tracking-wide">Calorie history</p>
            <p class="text-[20px] font-semibold tracking-[-0.6px] text-[#171717] mt-0.5" id="history-title">Last 7 days</p>
          </div>
          <div class="flex gap-1">
            <button data-days="7" class="hist-range-btn px-3 h-7 rounded-full text-[12px] bg-[#171717] text-white transition-colors">7D</button>
            <button data-days="30" class="hist-range-btn px-3 h-7 rounded-full text-[12px] text-[#888888] hover:bg-[#fafafa] transition-colors">30D</button>
          </div>
        </div>

        <div id="chart-container" class="relative">
          <div id="chart-loading" class="h-40 flex items-center justify-center">
            <div class="w-8 h-8 rounded-full border-2 border-[#ebebeb] border-t-[#171717] animate-spin"></div>
          </div>
          <div id="chart-bars" class="flex items-end gap-3 h-40 hidden"></div>
        </div>

        <div class="mt-4 pt-4 border-t border-[#ebebeb] flex items-center gap-6 text-[12px] text-[#888888] flex-wrap">
          <span id="hist-avg">Avg: <strong class="text-[#171717]">— kcal</strong></span>
          <span id="hist-goal">Goal: <strong class="text-[#171717]">— kcal</strong></span>
          <span id="hist-streak">Streak: <strong class="text-[#171717]">— days</strong></span>
        </div>
      </div>

      <!-- Today's macro donut (right col) -->
      <div class="rounded-[12px] bg-white border border-[#ebebeb] p-6 shadow-card">
        <p class="text-[12px] font-mono text-[#888888] uppercase tracking-wide mb-5">Today's macros</p>
        <div class="flex justify-center mb-6">
          <svg width="140" height="140" viewBox="0 0 140 140">
            <circle cx="70" cy="70" r="50" fill="none" stroke="#ebebeb" stroke-width="16"/>
            <circle id="donut-protein" cx="70" cy="70" r="50" fill="none" stroke="#3b82f6" stroke-width="16"
              stroke-dasharray="0 314" stroke-dashoffset="0"
              stroke-linecap="round" transform="rotate(-90 70 70)"/>
            <circle id="donut-carbs" cx="70" cy="70" r="50" fill="none" stroke="#f59e0b" stroke-width="16"
              stroke-dasharray="0 314" stroke-dashoffset="0"
              stroke-linecap="round" transform="rotate(-90 70 70)"/>
            <circle id="donut-fat" cx="70" cy="70" r="50" fill="none" stroke="#ef4444" stroke-width="16"
              stroke-dasharray="0 314" stroke-dashoffset="0"
              stroke-linecap="round" transform="rotate(-90 70 70)"/>
            <text id="donut-cal" x="70" y="66" text-anchor="middle" font-size="18" font-weight="600" fill="#171717">—</text>
            <text x="70" y="82" text-anchor="middle" font-size="11" fill="#888888">kcal</text>
          </svg>
        </div>
        <div class="space-y-3" id="macro-list">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <div class="w-2.5 h-2.5 rounded-full bg-[#3b82f6]"></div>
              <span class="text-[13px] text-[#4d4d4d]">Protein</span>
            </div>
            <span id="macro-protein" class="text-[13px] font-mono font-medium text-[#171717]">—</span>
          </div>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <div class="w-2.5 h-2.5 rounded-full bg-[#f59e0b]"></div>
              <span class="text-[13px] text-[#4d4d4d]">Carbs</span>
            </div>
            <span id="macro-carbs" class="text-[13px] font-mono font-medium text-[#171717]">—</span>
          </div>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <div class="w-2.5 h-2.5 rounded-full bg-[#ef4444]"></div>
              <span class="text-[13px] text-[#4d4d4d]">Fat</span>
            </div>
            <span id="macro-fat" class="text-[13px] font-mono font-medium text-[#171717]">—</span>
          </div>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <div class="w-2.5 h-2.5 rounded-full bg-[#10b981]"></div>
              <span class="text-[13px] text-[#4d4d4d]">Fibre</span>
            </div>
            <span id="macro-fiber" class="text-[13px] font-mono font-medium text-[#171717]">—</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Today's meals -->
    <div class="mt-6 rounded-[12px] bg-white border border-[#ebebeb] overflow-hidden shadow-card">
      <div class="px-6 py-4 border-b border-[#ebebeb] flex items-center justify-between">
        <div>
          <p class="text-[12px] font-mono text-[#888888] uppercase tracking-wide">Today's meals</p>
          <p id="meals-date" class="text-[13px] text-[#4d4d4d] mt-0.5"></p>
        </div>
        <a href="/" class="px-4 h-8 rounded-full bg-[#171717] text-white text-[12px] font-medium flex items-center hover:bg-[#333] transition-colors">+ Scan meal</a>
      </div>
      <div id="today-meals-list" class="divide-y divide-[#ebebeb]"><!-- JS populated --></div>
      <div id="today-meals-empty" class="hidden px-6 py-10 text-center">
        <p class="text-[14px] text-[#888888]">No meals logged today.</p>
        <a href="/" class="text-[13px] text-[#0070f3] hover:underline mt-1 inline-block">Scan your first meal →</a>
      </div>
    </div>

    <!-- Daily nutrition report table -->
    <div class="mt-6 rounded-[12px] bg-white border border-[#ebebeb] overflow-hidden shadow-card">
      <div class="px-6 py-4 border-b border-[#ebebeb] flex items-center justify-between flex-wrap gap-2">
        <div>
          <p class="text-[12px] font-mono text-[#888888] uppercase tracking-wide">Daily nutrition report</p>
          <p id="daily-report-subtitle" class="text-[13px] text-[#4d4d4d] mt-0.5">Your intake vs. recommended daily reference values</p>
        </div>
        <span id="daily-report-badge" class="text-[11px] font-mono text-[#888888] bg-[#fafafa] border border-[#ebebeb] px-2 py-1 rounded-full">Based on WHO / EU NRV</span>
      </div>
      <div class="flex border-b border-[#ebebeb]">
        <button id="dtab-macros" onclick="switchDTab('macros')"
          class="flex-1 py-2.5 text-[12px] font-medium text-[#171717] border-b-2 border-[#171717] transition-colors">Macros & Energy</button>
        <button id="dtab-micros" onclick="switchDTab('micros')"
          class="flex-1 py-2.5 text-[12px] font-medium text-[#888888] border-b-2 border-transparent hover:text-[#171717] transition-colors">Vitamins & Minerals</button>
      </div>
      <div class="overflow-x-auto">
        <div class="min-w-[500px]">
          <div class="grid grid-cols-5 px-6 py-2 bg-[#fafafa] border-b border-[#ebebeb]">
            <span class="col-span-2 text-[11px] font-mono text-[#888888] uppercase tracking-wide">Nutrient</span>
            <span class="text-[11px] font-mono text-[#888888] uppercase tracking-wide text-right">Consumed</span>
            <span id="dash-ref-col" class="text-[11px] font-mono text-[#888888] uppercase tracking-wide text-right">Daily ref.</span>
            <span class="text-[11px] font-mono text-[#888888] uppercase tracking-wide text-right">Status</span>
          </div>
          <div id="daily-table-macros" class="divide-y divide-[#ebebeb]"><!-- JS --></div>
          <div id="daily-table-micros" class="divide-y divide-[#ebebeb] hidden"><!-- JS --></div>
        </div>
      </div>
    </div>

    <!-- Nutritional gaps -->
    <div class="mt-6 rounded-[12px] bg-[#171717] p-6 shadow-card-lg" id="gaps-section">
      <div class="flex items-center gap-2 mb-5">
        <div class="w-5 h-5 rounded-full bg-[#50e3c2] flex items-center justify-center">
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
            <path d="M2 5l2 2 4-4" stroke="#171717" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <p class="text-[12px] font-mono text-[#50e3c2] uppercase tracking-wide">Nutritional gaps today</p>
      </div>
      <div id="gaps-empty" class="text-[14px] text-[#888888]">No meals logged yet. Scan a meal to see your nutritional gaps.</div>
      <div class="grid sm:grid-cols-3 gap-4 hidden" id="gap-cards"><!-- JS --></div>
    </div>

  </main>
</Layout>

<script>
// ── Helpers ────────────────────────────────────────────────────────────────
async function apiFetch(url: string) {
  try { const r = await fetch(url); return r.ok ? r.json() : null; } catch { return null; }
}

function statusBadge(pct: number, isNeg = false) {
  let label: string, color: string;
  if (isNeg) {
    if (pct > 100) { label = 'High'; color = '#ee0000'; }
    else if (pct > 75) { label = 'Caution'; color = '#f5a623'; }
    else { label = 'OK'; color = '#10b981'; }
  } else {
    if (pct >= 80) { label = 'Good'; color = '#10b981'; }
    else if (pct >= 40) { label = 'Fair'; color = '#f5a623'; }
    else { label = 'Low'; color = '#ee0000'; }
  }
  return `<span class="px-2 py-0.5 rounded-full text-[11px] font-medium" style="background:${color}20;color:${color}">${label}</span>`;
}

function tableRow(name: string, val: number, unit: string, ref: number, isNeg = false) {
  const pct = Math.round((val / ref) * 100);
  const barW = Math.min(pct, 100);
  const barColor = isNeg
    ? (pct > 100 ? '#ee0000' : pct > 75 ? '#f5a623' : '#10b981')
    : (pct >= 80 ? '#10b981' : pct >= 40 ? '#f5a623' : '#ee0000');
  return `
    <div class="grid grid-cols-5 items-center px-6 py-3 hover:bg-[#fafafa] transition-colors">
      <div class="col-span-2">
        <p class="text-[13px] text-[#171717] font-medium">${name}</p>
        <div class="mt-1 h-1 w-full rounded-full bg-[#ebebeb] overflow-hidden">
          <div class="h-full rounded-full transition-all duration-700" style="width:${barW}%;background:${barColor}"></div>
        </div>
      </div>
      <p class="text-[13px] font-mono text-[#171717] text-right">${val}${unit}</p>
      <p class="text-[13px] font-mono text-[#888888] text-right">${ref}${unit}</p>
      <div class="flex justify-end">${statusBadge(pct, isNeg)}</div>
    </div>`;
}

// ── Tab switcher ───────────────────────────────────────────────────────────
(window as any).switchDTab = (tab: 'macros' | 'micros') => {
  const mTab = document.getElementById('dtab-macros')!;
  const vTab = document.getElementById('dtab-micros')!;
  const mBody = document.getElementById('daily-table-macros')!;
  const vBody = document.getElementById('daily-table-micros')!;
  if (tab === 'macros') {
    mTab.className = 'flex-1 py-2.5 text-[12px] font-medium text-[#171717] border-b-2 border-[#171717] transition-colors';
    vTab.className = 'flex-1 py-2.5 text-[12px] font-medium text-[#888888] border-b-2 border-transparent hover:text-[#171717] transition-colors';
    mBody.classList.remove('hidden'); vBody.classList.add('hidden');
  } else {
    vTab.className = 'flex-1 py-2.5 text-[12px] font-medium text-[#171717] border-b-2 border-[#171717] transition-colors';
    mTab.className = 'flex-1 py-2.5 text-[12px] font-medium text-[#888888] border-b-2 border-transparent hover:text-[#171717] transition-colors';
    vBody.classList.remove('hidden'); mBody.classList.add('hidden');
  }
};

// ── Guest token ────────────────────────────────────────────────────────────
const GUEST_TOKEN = localStorage.getItem('mct_guest_token');

// ── Load data ──────────────────────────────────────────────────────────────
async function loadDashboard() {
  const params = GUEST_TOKEN ? `?guest_token=${GUEST_TOKEN}` : '';
  const [dailyData, historyData, profileData] = await Promise.all([
    apiFetch(`/api/daily${params}`),
    apiFetch(`/api/history${params}`),
    apiFetch('/api/profile'),
  ]);

  if (!dailyData) {
    document.getElementById('summary-cards')!.innerHTML = `<div class="col-span-full text-center py-10 text-[#888888]">Sign in or create a guest session to see your dashboard.</div>`;
    return;
  }

  const { targets, consumed, remaining, progress, meals, date, mealsPerDay, hasProfile } = dailyData;

  // ── Summary cards ──
  const calPct = progress.calories;
  const proPct = progress.protein;
  const carbPct = progress.carbs;
  const fatPct = progress.fat;

  document.getElementById('sc-cal-val')!.textContent = consumed.calories.toString();
  document.getElementById('sc-cal-goal')!.textContent = targets.calories.toString();
  (document.getElementById('sc-cal-bar') as HTMLElement).style.width = calPct + '%';
  document.getElementById('sc-cal-pct')!.textContent = `${calPct}% of ${targets.calories} kcal goal`;

  document.getElementById('sc-pro-val')!.textContent = consumed.protein.toString();
  document.getElementById('sc-pro-goal')!.textContent = targets.protein.toString();
  (document.getElementById('sc-pro-bar') as HTMLElement).style.width = proPct + '%';
  document.getElementById('sc-pro-pct')!.textContent = `${proPct}% of ${targets.protein}g goal`;

  document.getElementById('sc-carb-val')!.textContent = consumed.carbs.toString();
  document.getElementById('sc-carb-goal')!.textContent = targets.carbs.toString();
  (document.getElementById('sc-carb-bar') as HTMLElement).style.width = carbPct + '%';
  document.getElementById('sc-carb-pct')!.textContent = `${carbPct}% of ${targets.carbs}g goal`;

  document.getElementById('sc-fat-val')!.textContent = consumed.fat.toString();
  document.getElementById('sc-fat-goal')!.textContent = targets.fat.toString();
  (document.getElementById('sc-fat-bar') as HTMLElement).style.width = fatPct + '%';
  document.getElementById('sc-fat-pct')!.textContent = `${fatPct}% of ${targets.fat}g goal`;

  // ── Meals Logged ──
  const mealsCount = consumed.meals || 0;
  const mealsGoal = mealsPerDay || 3;
  const mealsPct = Math.min(100, Math.round(mealsCount / mealsGoal * 100));
  document.getElementById('sc-meals-val')!.textContent = mealsCount.toString();
  document.getElementById('sc-meals-goal')!.textContent = mealsGoal.toString();
  (document.getElementById('sc-meals-bar') as HTMLElement).style.width = mealsPct + '%';
  document.getElementById('sc-meals-pct')!.textContent = `${mealsCount} of ${mealsGoal} meals`;

  // ── Remaining banner ──
  if (consumed.calories > 0) {
    const remBanner = document.getElementById('remaining-banner')!;
    remBanner.classList.remove('hidden');
    document.getElementById('remaining-grid')!.innerHTML = [
      { label: 'Calories left', val: remaining.calories, unit: 'kcal', color: '#ffffff' },
      { label: 'Protein left',  val: remaining.protein,  unit: 'g',    color: '#3b82f6' },
      { label: 'Carbs left',    val: remaining.carbs,    unit: 'g',    color: '#f59e0b' },
      { label: 'Fat left',      val: remaining.fat,      unit: 'g',    color: '#ef4444' },
    ].map(s => `
      <div class="rounded-[8px] bg-white/5 border border-white/10 p-4 text-center">
        <p class="text-[22px] font-semibold tracking-[-0.8px]" style="color:${s.color}">${s.val}</p>
        <p class="text-[11px] text-[#888888] mt-0.5">${s.label} (${s.unit})</p>
      </div>`).join('');
  }

  // ── Macro donut ──
  const totalMacroCal = consumed.protein * 4 + consumed.carbs * 4 + consumed.fat * 9;
  const proPctDonut = totalMacroCal > 0 ? Math.round(consumed.protein * 4 / totalMacroCal * 314) : 0;
  const carbPctDonut = totalMacroCal > 0 ? Math.round(consumed.carbs * 4 / totalMacroCal * 314) : 0;
  const fatPctDonut = totalMacroCal > 0 ? Math.round(consumed.fat * 9 / totalMacroCal * 314) : 0;
  document.getElementById('donut-protein')!.setAttribute('stroke-dasharray', `${proPctDonut} 314`);
  document.getElementById('donut-carbs')!.setAttribute('stroke-dasharray', `${carbPctDonut} 314`);
  document.getElementById('donut-fat')!.setAttribute('stroke-dasharray', `${fatPctDonut} 314`);
  document.getElementById('donut-cal')!.textContent = consumed.calories.toString();

  document.getElementById('macro-protein')!.textContent = `${consumed.protein}g / ${targets.protein}g`;
  document.getElementById('macro-carbs')!.textContent = `${consumed.carbs}g / ${targets.carbs}g`;
  document.getElementById('macro-fat')!.textContent = `${consumed.fat}g / ${targets.fat}g`;
  document.getElementById('macro-fiber')!.textContent = `${consumed.fiber}g`;

  // ── Date label ──
  document.getElementById('meals-date')!.textContent = new Date().toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long' });

  // ── Today's meals list ──
  const mealsList = document.getElementById('today-meals-list')!;
  const mealsEmpty = document.getElementById('today-meals-empty')!;
  const emojis = ['🍛','🥗','🥣','🌯','🍲','🥦','🐟','🥑','🍚','🫙'];
  if (!meals || meals.length === 0) {
    mealsEmpty.classList.remove('hidden');
  } else {
    mealsList.innerHTML = meals.map((m: any, i: number) => `
      <div class="px-6 py-4 flex items-center gap-4 hover:bg-[#fafafa] transition-colors">
        <div class="w-10 h-10 rounded-[8px] bg-[#fafafa] border border-[#ebebeb] flex items-center justify-center text-xl shrink-0">
          ${emojis[i % emojis.length]}
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-[14px] font-medium text-[#171717] truncate">${m.meal_name}</p>
          <p class="text-[12px] font-mono text-[#888888]">${m.meal_type ? m.meal_type.charAt(0).toUpperCase() + m.meal_type.slice(1) : 'Meal'} ${m.meal_number > 0 ? '#' + m.meal_number : ''}</p>
        </div>
        <div class="hidden sm:flex items-center gap-5 text-[12px] font-mono text-[#888888] shrink-0">
          <span><strong class="text-[#3b82f6]">${m.protein}g</strong> protein</span>
          <span><strong class="text-[#f59e0b]">${m.carbs}g</strong> carbs</span>
          <span><strong class="text-[#ef4444]">${m.fat}g</strong> fat</span>
        </div>
        <div class="text-right shrink-0">
          <p class="text-[15px] font-semibold text-[#171717]">${m.calories}</p>
          <p class="text-[11px] text-[#888888]">kcal</p>
        </div>
      </div>`).join('');
  }

  // ── Daily nutrition report — Macros (use personalized targets) ──
  if (hasProfile) {
    document.getElementById('daily-report-badge')!.textContent = 'Compared with your personalized daily target';
    document.getElementById('daily-report-subtitle')!.textContent = 'Your intake vs. your personalized daily targets';
    document.getElementById('dash-ref-col')!.textContent = 'Your target';
  } else {
    document.getElementById('daily-report-badge')!.textContent = 'Compared with standard daily nutrition recommendations';
    document.getElementById('daily-report-subtitle')!.textContent = 'Your intake vs. recommended daily reference values';
    document.getElementById('dash-ref-col')!.textContent = 'Daily ref.';
  }
  document.getElementById('daily-table-macros')!.innerHTML = [
    tableRow('Energy',   consumed.calories,             'kcal', targets.calories),
    tableRow('Protein',  consumed.protein,              'g',    targets.protein),
    tableRow('Carbs',    consumed.carbs,                'g',    targets.carbs),
    tableRow('Fat',      consumed.fat,                  'g',    targets.fat),
    tableRow('Fibre',    consumed.fiber,                'g',    25),
    tableRow('Sugar',    Math.round(consumed.carbs * 0.3), 'g', 90, true),
    tableRow('Sat. Fat', Math.round(consumed.fat * 0.4),   'g', 20, true),
  ].join('');

  // ── Daily nutrition report — Micros ──
  const mScale = meals && meals.length > 0 ? meals.length * 0.6 : 0;
  document.getElementById('daily-table-micros')!.innerHTML = [
    tableRow('Vitamin A',   Math.round(180 * mScale), 'µg', 800),
    tableRow('Vitamin C',   Math.round(12  * mScale), 'mg', 80),
    tableRow('Vitamin D',   Math.round(1.2 * mScale * 10) / 10, 'µg', 15),
    tableRow('Vitamin E',   Math.round(2.4 * mScale * 10) / 10, 'mg', 12),
    tableRow('Vitamin K',   Math.round(18  * mScale), 'µg', 75),
    tableRow('Vitamin B12', Math.round(0.6 * mScale * 10) / 10, 'µg', 2.4),
    tableRow('Folate',      Math.round(32  * mScale), 'µg', 200),
    tableRow('Iron',        Math.round(3.2 * mScale * 10) / 10, 'mg', 14),
    tableRow('Calcium',     Math.round(95  * mScale), 'mg', 800),
    tableRow('Potassium',   Math.round(420 * mScale), 'mg', 2000),
    tableRow('Sodium',      Math.round(680 * mScale), 'mg', 2300, true),
    tableRow('Zinc',        Math.round(2.1 * mScale * 10) / 10, 'mg', 10),
    tableRow('Magnesium',   Math.round(38  * mScale), 'mg', 375),
  ].join('');

  // ── Nutritional gaps ──
  if (meals && meals.length > 0) {
    const gaps = [
      { nutrient: 'Vitamin D', current: Math.round(1.2 * mScale * 10) / 10, target: 15, unit: 'µg', tip: 'Add fatty fish or fortified milk.' },
      { nutrient: 'Iron',      current: Math.round(3.2 * mScale * 10) / 10, target: 14, unit: 'mg', tip: 'Try spinach, lentils or red meat.' },
      { nutrient: 'Calcium',   current: Math.round(95 * mScale), target: 800, unit: 'mg', tip: 'Include dairy, tofu or broccoli.' },
    ];
    const gapsEmpty = document.getElementById('gaps-empty')!;
    const gapCards = document.getElementById('gap-cards')!;
    gapsEmpty.classList.add('hidden');
    gapCards.classList.remove('hidden');
    gapCards.innerHTML = gaps.map(g => {
      const pct = Math.min(Math.round(g.current / g.target * 100), 100);
      return `
        <div class="rounded-[8px] bg-white/5 border border-white/10 p-4">
          <p class="text-[13px] font-medium text-white mb-1">${g.nutrient}</p>
          <p class="text-[12px] font-mono text-[#888888] mb-3">${g.current}${g.unit} / ${g.target}${g.unit}</p>
          <div class="h-1 rounded-full bg-white/10 overflow-hidden mb-2">
            <div class="h-full rounded-full bg-[#50e3c2]" style="width:${pct}%"></div>
          </div>
          <p class="text-[12px] text-[#888888]">${g.tip}</p>
        </div>`;
    }).join('');
  }

  // ── Goal weight banner ──
  if (profileData?.profile) {
    const p = profileData.profile;
    if (p.weight && p.targetWeight) {
      const banner = document.getElementById('goal-weight-banner')!;
      banner.classList.remove('hidden');
      const start = p.startWeight || p.weight;
      const current = p.weight;
      const target = p.targetWeight;
      const totalDiff = Math.abs(start - target);
      const done = Math.abs(start - current);
      const pct = totalDiff > 0 ? Math.min(Math.round(done / totalDiff * 100), 100) : 0;
      const remaining = Math.abs(current - target).toFixed(1);
      const weeksEta = Math.ceil(parseFloat(remaining) / 0.5);
      document.getElementById('gw-current')!.textContent = current;
      document.getElementById('gw-target')!.textContent = target;
      document.getElementById('gw-remaining')!.textContent = `${remaining} kg to go`;
      document.getElementById('gw-pct')!.textContent = pct + '%';
      (document.getElementById('gw-bar') as HTMLElement).style.width = pct + '%';
      document.getElementById('gw-eta')!.textContent = `Est. ${weeksEta} week${weeksEta !== 1 ? 's' : ''} at 0.5 kg/week`;
    }
  }

  // ── History chart ──
  renderChart(historyData, targets.calories);
}

// ── Chart rendering ────────────────────────────────────────────────────────
let currentDays = 7;
async function renderChart(historyData: any, goalCal: number) {
  const loadingEl = document.getElementById('chart-loading')!;
  const barsEl = document.getElementById('chart-bars')!;

  if (!historyData || !historyData.summaries || historyData.summaries.length === 0) {
    loadingEl.innerHTML = '<p class="text-[14px] text-[#888888]">No history yet. Start scanning meals!</p>';
    return;
  }

  const summaries = historyData.summaries.slice(0, currentDays).reverse();
  const avg = Math.round(summaries.reduce((a: number, s: any) => a + s.calories, 0) / summaries.length);
  const streak = summaries.filter((s: any) => s.calories > 0).length;
  const goal = goalCal || 2000;

  document.getElementById('hist-avg')!.innerHTML = `Avg: <strong class="text-[#171717]">${avg} kcal</strong>`;
  document.getElementById('hist-goal')!.innerHTML = `Goal: <strong class="text-[#171717]">${goal} kcal</strong>`;
  document.getElementById('hist-streak')!.innerHTML = `Streak: <strong class="text-[#171717]">${streak} days</strong>`;

  loadingEl.classList.add('hidden');
  barsEl.classList.remove('hidden');
  barsEl.innerHTML = summaries.map((s: any, i: number) => {
    const pct = Math.min(Math.round(s.calories / goal * 100), 100);
    const isToday = i === summaries.length - 1;
    const date = new Date(s.date + 'T00:00:00');
    const dayLabel = date.toLocaleDateString('en-GB', { weekday: 'short' });
    return `
      <div class="flex-1 flex flex-col items-center gap-1.5">
        <span class="text-[11px] font-mono text-[#888888]">${s.calories > 0 ? s.calories : ''}</span>
        <div class="w-full rounded-t-[4px] transition-all duration-700"
          style="height:${Math.max(pct, 2)}%;background:${isToday ? '#171717' : '#ebebeb'};min-height:4px"></div>
        <span class="text-[11px] text-[#888888]">${dayLabel}</span>
        <span class="text-[9px] font-mono text-[#888888]">${s.date.slice(5)}</span>
      </div>`;
  }).join('');
}

// ── Range button handlers ──────────────────────────────────────────────────
document.querySelectorAll('.hist-range-btn').forEach(btn => {
  btn.addEventListener('click', async () => {
    const days = parseInt((btn as HTMLElement).dataset.days || '7');
    currentDays = days;
    document.getElementById('history-title')!.textContent = days === 7 ? 'Last 7 days' : 'Last 30 days';
    document.querySelectorAll('.hist-range-btn').forEach(b => {
      b.classList.remove('bg-[#171717]', 'text-white');
      b.classList.add('text-[#888888]', 'hover:bg-[#fafafa]');
    });
    btn.classList.add('bg-[#171717]', 'text-white');
    btn.classList.remove('text-[#888888]', 'hover:bg-[#fafafa]');

    const params = GUEST_TOKEN ? `?guest_token=${GUEST_TOKEN}&days=${days}` : `?days=${days}`;
    const historyData = await apiFetch(`/api/history${params}`);
    const dailyData = await apiFetch(`/api/daily${GUEST_TOKEN ? `?guest_token=${GUEST_TOKEN}` : ''}`);
    const goalCal = dailyData?.targets?.calories || 2000;
    renderChart(historyData, goalCal);
  });
});

// ── Init ───────────────────────────────────────────────────────────────────
loadDashboard();
</script>
