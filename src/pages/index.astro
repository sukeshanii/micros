// ── Status badge helper ────────────────────────────────────────────────────
function statusBadge(pct: number, isNegative = false): string {
  // isNegative = lower is better (sodium, sat fat, sugar)
  let label: string, color: string;
  if (isNegative) {
    if (pct > 100)      { label = 'High';    color = '#ee0000'; }
    else if (pct > 75)  { label = 'Caution'; color = '#f5a623'; }
    else                { label = 'OK';      color = '#10b981'; }
  } else {
    if (pct >= 80)      { label = 'Good';    color = '#10b981'; }
    else if (pct >= 40) { label = 'Fair';    color = '#f5a623'; }
    else                { label = 'Low';     color = '#ee0000'; }
  }
  return `<span class="px-2 py-0.5 rounded-full text-[11px] font-medium" style="background:${color}20;color:${color}">${label}</span>`;
}

// ── Render nutrition table row ─────────────────────────────────────────────
function tableRow(name: string, val: number, unit: string, ref: number, isNeg = false): string {
  const pct = Math.round((val / ref) * 100);
  const barW = Math.min(pct, 100);
  const barColor = isNeg
    ? (pct > 100 ? '#ee0000' : pct > 75 ? '#f5a623' : '#10b981')
    : (pct >= 80 ? '#10b981' : pct >= 40 ? '#f5a623' : '#ee0000');
  return `
    <div class="grid grid-cols-5 items-center px-5 py-3 hover:bg-[#fafafa] transition-colors">
      <div class="col-span-2">
        <p class="text-[13px] text-[#171717] font-medium">${name}</p>
        <div class="mt-1 h-1 w-full rounded-full bg-[#ebebeb] overflow-hidden">
          <div class="h-full rounded-full transition-all duration-700" style="width:${barW}%;background:${barColor}"></div>
        </div>
      </div>
      <p class="text-[13px] font-mono text-[#171717] text-right">${val}${unit}</p>
      <p class="text-[13px] font-mono text-[#888888] text-right">${ref}${unit}</p>
      <div class="flex justify-end">${statusBadge(pct, isNeg)}</div>
    </div>`;
}

