// Default fallback for unknown dishes
const DEFAULT_DISH = { ingredients: ['Mixed Ingredients','Vegetables','Oil','Salt','Spices','Herbs'], calPer100: 150, proteinPer100: 8, carbsPer100: 20, fatPer100: 5, fiberPer100: 1.5 };

function matchDish(dishName: string): typeof DEFAULT_DISH {
  if (!dishName) return DEFAULT_DISH;
  const lower = dishName.toLowerCase().trim();

  // Exact match — instant win
  if (DISH_DB[lower]) return DISH_DB[lower];

  const keys = Object.keys(DISH_DB);
  const words = lower.split(/\s+/).filter(w => w.length >= 2);

  let bestScore = 0;
  let bestKey = '';

  for (const key of keys) {
    let score = 0;
    const keyWords = key.split(/\s+/);

    // Award points for each input word that appears in the key
    for (const w of words) {
      if (key.includes(w)) score += 10;
      if (key === w) score += 15;           // exact word match bonus
      for (const kw of keyWords) {
        if (kw.includes(w) || w.includes(kw)) score += 5;
      }
    }

    // Bonus: key contains the full input (user typed a sub-string of a dish name)
    if (key.includes(lower)) score += 8;
    // Bonus: every key-word matched at least once
    const matchedAllKeyWords = keyWords.every(kw =>
      kw.length < 3 || words.some(w => kw.includes(w) || w.includes(kw))
    );
    if (matchedAllKeyWords) score += 6;

    // Longer, more specific dish names get a small boost as a tiebreaker
    score += key.length * 0.5;

    if (score > bestScore) {
      bestScore = score;
      bestKey = key;
    }
  }

  return bestScore >= 10 ? DISH_DB[bestKey] : DEFAULT_DISH;
}

// ── Mock AI result ─────────────────────────────────────────────────────────
function getMockResult(dishName: string, weight: number, age: number, userWeight: number, goal: string): NutritionResult {
  const dish = matchDish(dishName);
  const s = weight / 100;
  const calories = Math.round(dish.calPer100 * s);
  const protein  = Math.round(dish.proteinPer100 * s);
  const carbs    = Math.round(dish.carbsPer100 * s);
  const fat      = Math.round(dish.fatPer100 * s);
  const fiber    = Math.round(dish.fiberPer100 * s);

  const sugg: string[] = [];
  if (protein < 30) sugg.push('Add a protein source — grilled chicken, tofu, or lentils — to hit your daily target.');
  if (fiber < 8)    sugg.push('Include leafy greens (spinach, kale) or legumes to boost fibre intake.');
  if (goal === 'lose') sugg.push('Reduce portion by ~15% and add a side salad to stay satiated with fewer calories.');
  if (goal === 'gain') sugg.push('Add a handful of nuts or a protein shake alongside this meal to support muscle growth.');
  if (age > 40)     sugg.push('Prioritise calcium-rich foods (dairy, broccoli) to support bone density.');
  if (userWeight > 90) sugg.push('Swap refined carbs for whole grains to improve insulin sensitivity.');
  if (sugg.length === 0) sugg.push('Great balance! Your meal covers key macros well. Stay hydrated.');

  // Next meal ideas based on what's missing
  const nextMeals = goal === 'lose'
    ? [
        { name: 'Grilled Salmon Salad', emoji: '🥗', cal: 320, reason: 'High protein, low carb' },
        { name: 'Lentil Soup',          emoji: '🍲', cal: 280, reason: 'Rich in fibre & iron' },
        { name: 'Greek Yogurt Bowl',    emoji: '🥣', cal: 210, reason: 'Probiotic + calcium boost' },
      ]
    : goal === 'gain'
    ? [
        { name: 'Chicken & Rice Bowl',  emoji: '🍚', cal: 620, reason: 'High protein + complex carbs' },
        { name: 'Peanut Butter Toast',  emoji: '🥜', cal: 420, reason: 'Healthy fats + energy' },
        { name: 'Egg & Avocado Wrap',   emoji: '🌯', cal: 480, reason: 'Complete amino acids' },
      ]
    : [
        { name: 'Veggie Stir Fry',      emoji: '🥦', cal: 350, reason: 'Micronutrient dense' },
        { name: 'Quinoa Buddha Bowl',   emoji: '🫙', cal: 410, reason: 'Complete protein + fibre' },
        { name: 'Fruit & Nut Snack',    emoji: '🍎', cal: 180, reason: 'Natural sugars + antioxidants' },
      ];

  return {
    mealName: dishName || 'Mixed meal', weight, calories,
    macros: { protein, carbs, fat, fiber },
    micros: {
      'Vitamin A':  { val: Math.round(180*s/3.5),          unit: 'µg', ref: 800  },
      'Vitamin C':  { val: Math.round(12*s/3.5),            unit: 'mg', ref: 80   },
      'Vitamin D':  { val: Math.round(1.2*s/3.5*10)/10,     unit: 'µg', ref: 15   },
      'Vitamin E':  { val: Math.round(2.4*s/3.5*10)/10,     unit: 'mg', ref: 12   },
      'Vitamin K':  { val: Math.round(18*s/3.5),            unit: 'µg', ref: 75   },
      'Vitamin B12':{ val: Math.round(0.6*s/3.5*10)/10,     unit: 'µg', ref: 2.4  },
      'Folate':     { val: Math.round(32*s/3.5),            unit: 'µg', ref: 200  },
      'Iron':       { val: Math.round(3.2*s/3.5*10)/10,     unit: 'mg', ref: 14   },
      'Calcium':    { val: Math.round(95*s/3.5),            unit: 'mg', ref: 800  },
      'Potassium':  { val: Math.round(420*s/3.5),           unit: 'mg', ref: 2000 },
      'Sodium':     { val: Math.round(680*s/3.5),           unit: 'mg', ref: 2300 },
      'Zinc':       { val: Math.round(2.1*s/3.5*10)/10,     unit: 'mg', ref: 10   },
      'Magnesium':  { val: Math.round(38*s/3.5),            unit: 'mg', ref: 375  },
    },
    ingredients: dish.ingredients,
    suggestions: sugg,
    nextMeals,
  };
}

// ── Render daily progress (uses running log totals) ────────────────────────
function renderDailyProgress(newMeal: NutritionResult, calGoal: number) {
  const totals = getDailyTotals();
  const rows = [
    { label: 'Calories', val: totals.calories, goal: calGoal,  unit: 'kcal', color: '#171717' },
    { label: 'Protein',  val: totals.protein,  goal: Math.round(calGoal*0.25/4), unit: 'g', color: '#3b82f6' },
    { label: 'Carbs',    val: totals.carbs,    goal: Math.round(calGoal*0.5/4),  unit: 'g', color: '#f59e0b' },
    { label: 'Fat',      val: totals.fat,      goal: Math.round(calGoal*0.25/9), unit: 'g', color: '#ef4444' },
  ];
  return rows.map(r => {
    const pct = Math.min(Math.round(r.val / r.goal * 100), 100);
    const over = r.val > r.goal;
    return `
      <div>
        <div class="flex justify-between text-[12px] mb-1">
          <span class="text-[#4d4d4d]">${r.label}</span>
          <span class="font-mono ${over ? 'text-[#ee0000]' : 'text-[#888888]'}">${r.val}${r.unit} / ${r.goal}${r.unit}${over ? ' ⚠' : ''}</span>
        </div>
        <div class="h-1.5 rounded-full bg-[#ebebeb] overflow-hidden">
          <div class="h-full rounded-full transition-all duration-1000" style="width:${pct}%;background:${over ? '#ee0000' : r.color}"></div>
        </div>
      </div>`;
  }).join('');
}

// ── Meal type selector ─────────────────────────────────────────────────────
let selectedMealType: MealType = 'lunch';
const mealTypeBtns = document.querySelectorAll('.meal-type-btn');
function updateMealTypeUI() {
  mealTypeBtns.forEach(btn => {
    const type = (btn as HTMLElement).dataset.mealType as MealType;
    if (type === selectedMealType) {
      btn.classList.remove('bg-white','text-[#4d4d4d]','border-[#ebebeb]');
      btn.classList.add('bg-[#171717]','text-white','border-[#171717]');
    } else {
      btn.classList.remove('bg-[#171717]','text-white','border-[#171717]');
      btn.classList.add('bg-white','text-[#4d4d4d]','border-[#ebebeb]');
    }
  });
}
mealTypeBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    selectedMealType = (btn as HTMLElement).dataset.mealType as MealType;
    updateMealTypeUI();
  });
});
// Auto-select based on current hour
const currentHour = new Date().getHours();
if (currentHour < 11) selectedMealType = 'breakfast';
else if (currentHour < 15) selectedMealType = 'lunch';
else if (currentHour < 18) selectedMealType = 'snack';
else if (currentHour < 21) selectedMealType = 'dinner';
else selectedMealType = 'dessert';
updateMealTypeUI();

// ── Render meals timeline ──────────────────────────────────────────────────
function renderTimeline() {
  const log = getLog();
  const dateEl = document.getElementById('timeline-date');
  const totalCalEl = document.getElementById('timeline-total-cal');
  const listEl = document.getElementById('meals-timeline')!;
  const emptyEl = document.getElementById('meals-timeline-empty')!;
  const summaryBar = document.getElementById('day-summary-bar')!;
  const summaryMacros = document.getElementById('day-summary-macros')!;

  if (dateEl) dateEl.textContent = new Date().toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long' });

  if (log.length === 0) {
    listEl.innerHTML = '';
    emptyEl.classList.remove('hidden');
    summaryBar.classList.add('hidden');
    if (totalCalEl) totalCalEl.textContent = '';
    return;
  }

  emptyEl.classList.add('hidden');
  summaryBar.classList.remove('hidden');

  const totals = getDailyTotals();
  if (totalCalEl) totalCalEl.textContent = `${totals.calories} kcal total`;

  // Group by meal type
  const mealOrder: MealType[] = ['breakfast','lunch','snack','dinner','dessert'];
  const grouped: Record<string, LoggedMeal[]> = {};
  log.forEach(m => {
    const type = m.mealType || 'lunch';
    if (!grouped[type]) grouped[type] = [];
    grouped[type].push(m);
  });

  let html = '';
  for (const type of mealOrder) {
    const meals = grouped[type];
    if (!meals || meals.length === 0) continue;
    const meta = MEAL_TYPE_META[type];
    const typeCal = meals.reduce((a, m) => a + m.calories, 0);

    html += `
      <div class="px-5 py-3 bg-[#fafafa] border-b border-[#ebebeb]">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="text-sm">${meta.emoji}</span>
            <span class="text-[12px] font-semibold text-[#171717] uppercase tracking-wide">${meta.label}</span>
            <span class="text-[11px] text-[#888888] font-mono">${meals.length} item${meals.length > 1 ? 's' : ''}</span>
          </div>
          <span class="text-[12px] font-mono font-medium" style="color:${meta.color}">${typeCal} kcal</span>
        </div>
      </div>`;

    meals.forEach(m => {
      html += `
        <div class="px-5 py-3 flex items-center gap-4 hover:bg-[#fafafa] transition-colors">
          <div class="w-8 h-8 rounded-full flex items-center justify-center text-[10px] font-mono font-medium shrink-0" style="background:${meta.color}18;color:${meta.color}">
            ${m.time}
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-[13px] font-medium text-[#171717] truncate">${m.name}</p>
          </div>
          <div class="hidden sm:flex items-center gap-3 text-[11px] font-mono text-[#888888] shrink-0">
            <span><strong class="text-[#3b82f6]">${m.protein}g</strong> P</span>
            <span><strong class="text-[#f59e0b]">${m.carbs}g</strong> C</span>
            <span><strong class="text-[#ef4444]">${m.fat}g</strong> F</span>
          </div>
          <div class="text-right shrink-0">
            <p class="text-[14px] font-semibold text-[#171717]">${m.calories}</p>
            <p class="text-[10px] text-[#888888]">kcal</p>
          </div>
        </div>`;
    });
  }

  listEl.innerHTML = html;

  // Day summary macros
  const summaryItems = [
    { label: 'Calories', val: totals.calories, unit: 'kcal', color: '#171717' },
    { label: 'Protein',  val: totals.protein,  unit: 'g',    color: '#3b82f6' },
    { label: 'Carbs',    val: totals.carbs,    unit: 'g',    color: '#f59e0b' },
    { label: 'Fat',      val: totals.fat,      unit: 'g',    color: '#ef4444' },
  ];
  summaryMacros.innerHTML = summaryItems.map(s => `
    <div class="text-center">
      <p class="text-[16px] font-semibold tracking-[-0.5px]" style="color:${s.color}">${s.val}</p>
      <p class="text-[10px] text-[#888888] mt-0.5">${s.label} (${s.unit})</p>
    </div>
  `).join('');
}

// Initial render of timeline (on page load)
renderTimeline();

// ── Analyse ────────────────────────────────────────────────────────────────
document.getElementById('analyse-btn')!.addEventListener('click', async () => {
  const dishName   = (document.getElementById('dish-name') as HTMLInputElement).value.trim();
  const mealWeight = parseInt((document.getElementById('meal-weight') as HTMLInputElement).value) || 350;
  const age        = parseInt((document.getElementById('quick-age') as HTMLInputElement).value) || 25;
  const userWeight = parseInt((document.getElementById('quick-weight') as HTMLInputElement).value) || 70;
  const goal       = (document.getElementById('quick-goal') as HTMLSelectElement).value;
  const calGoal    = goal === 'lose' ? 1500 : goal === 'gain' ? 2500 : 2000;

  emptyState.classList.add('hidden');
  resultsContent.classList.add('hidden');
  loadingState.classList.remove('hidden');

  await new Promise(r => setTimeout(r, 2000));

  const result = getMockResult(dishName, mealWeight, age, userWeight, goal);

  // Log this meal to daily tracker
  addToLog({
    name: result.mealName,
    calories: result.calories,
    protein: result.macros.protein,
    carbs: result.macros.carbs,
    fat: result.macros.fat,
    time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
    mealType: selectedMealType,
  });

  // ── Meal header ──
  document.getElementById('result-meal-name')!.textContent = result.mealName;
  document.getElementById('result-weight')!.textContent    = `~${result.weight}g serving`;
  document.getElementById('result-calories')!.textContent  = result.calories.toString();

  // ── Nutrition report table — Macros tab ──
  const macroRows = [
    tableRow('Energy',   result.calories,        'kcal', 2000),
    tableRow('Protein',  result.macros.protein,  'g',    50),
    tableRow('Carbs',    result.macros.carbs,    'g',    260),
    tableRow('Fat',      result.macros.fat,      'g',    70),
    tableRow('Fibre',    result.macros.fiber,    'g',    25),
    tableRow('Sugar',    Math.round(result.macros.carbs * 0.3), 'g', 90, true),
    tableRow('Sat. Fat', Math.round(result.macros.fat * 0.4),   'g', 20, true),
  ].join('');
  document.getElementById('nutrition-table-macros')!.innerHTML = macroRows;

  // ── Nutrition report table — Micros tab ──
  const microRows = Object.entries(result.micros).map(([name, d]) =>
    tableRow(name, d.val, d.unit, d.ref, name === 'Sodium')
  ).join('');
  document.getElementById('nutrition-table-micros')!.innerHTML = microRows;

  // ── AI suggestions ──
  document.getElementById('suggestions-list')!.innerHTML = result.suggestions.map(s =>
    `<p class="text-[14px] text-[#888888] leading-[20px] flex gap-2"><span class="text-[#50e3c2] shrink-0 mt-0.5">→</span>${s}</p>`
  ).join('');

  // ── Next meal ideas ──
  document.getElementById('next-meal-ideas')!.innerHTML = result.nextMeals.map(m => `
    <div class="rounded-[8px] bg-white/5 border border-white/10 p-3 hover:bg-white/10 transition-colors cursor-pointer">
      <div class="flex items-center gap-2 mb-1">
        <span class="text-lg">${m.emoji}</span>
        <span class="text-[13px] font-medium text-white">${m.name}</span>
      </div>
      <p class="text-[11px] text-[#888888]">${m.reason}</p>
      <p class="text-[11px] font-mono text-[#50e3c2] mt-1">~${m.cal} kcal</p>
    </div>`).join('');

  // ── Daily running total ──
  const log = getLog();
  document.getElementById('meals-logged-count')!.textContent = `${log.length} meal${log.length !== 1 ? 's' : ''} logged today`;
  document.getElementById('daily-progress')!.innerHTML = renderDailyProgress(result, calGoal);

  // ── Update timeline ──
  renderTimeline();

  loadingState.classList.add('hidden');
  resultsContent.classList.remove('hidden');

  if (window.innerWidth < 1024) {
    document.getElementById('results-panel')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
});
</script>

