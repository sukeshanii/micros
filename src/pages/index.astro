<script>
// ── Types ──────────────────────────────────────────────────────────────────
interface MacroData { protein: number; carbs: number; fat: number; fiber: number; }
interface NutritionResult {
  mealName: string; weight: number; calories: number;
  macros: MacroData;
  micros: Record<string, { val: number; unit: string; ref: number }>;
  ingredients: string[];
  suggestions: string[];
  nextMeals: { name: string; emoji: string; cal: number; reason: string }[];
  perMealTarget?: { calories: number; protein: number; carbs: number; fat: number };
  dailyTarget?: { calories: number; protein: number; carbs: number; fat: number };
  mealsPerDay?: number;
  hasProfile?: boolean;
}
interface LoggedMeal { name: string; calories: number; protein: number; carbs: number; fat: number; time: string; ingredients: string[]; }

// ── Guest token management ────────────────────────────────────────────────
let GUEST_TOKEN: string | null = localStorage.getItem('mct_guest_token');
function generateGuestToken(): string {
  const bytes = new Uint8Array(24);
  crypto.getRandomValues(bytes);
  return Array.from(bytes, b => b.toString(16).padStart(2, '0')).join('');
}

// ── Profile setup ─────────────────────────────────────────────────────────
function loadProfile() {
  try { return JSON.parse(localStorage.getItem('mct_profile') || '{}'); } catch { return {}; }
}
const savedProfile = loadProfile();

// ── Per-meal targets from server ──────────────────────────────────────────
let PER_MEAL_TARGETS = { calories: 667, protein: 33, carbs: 83, fat: 22 };
let DAILY_TARGETS = { calories: 2000, protein: 100, carbs: 250, fat: 65 };
let HAS_PROFILE = false;
const defaultMeals = parseInt(savedProfile.mealsPerDay) || 3;
let MEALS_PER_DAY = defaultMeals;

function calColor() {
  return '#ec4899';
}

async function loadTargets() {
  try {
    const r = await fetch('/api/meal-targets');
    if (r.ok) {
      const data = await r.json();
      HAS_PROFILE = data.hasProfile === true;
      DAILY_TARGETS = data.daily;
      PER_MEAL_TARGETS = data.currentMealTarget;
      MEALS_PER_DAY = data.mealsPerDay;
      renderDailyProgress();
      renderTimeline();
      return;
    }
  } catch {}
  if (GUEST_TOKEN) {
    try {
      const r = await fetch(`/api/meal-targets?guest_token=${GUEST_TOKEN}`);
      if (r.ok) {
        const data = await r.json();
        HAS_PROFILE = data.hasProfile === true;
        DAILY_TARGETS = data.daily;
        PER_MEAL_TARGETS = data.currentMealTarget;
        MEALS_PER_DAY = data.mealsPerDay;
        renderDailyProgress();
        renderTimeline();
      }
    } catch {}
  }
}

// ── Persistent daily log (localStorage) ───────────────────────────────────
const TODAY = new Date().toDateString();
function getLog(): LoggedMeal[] {
  try {
    const raw = localStorage.getItem('mct_log_' + TODAY);
    return raw ? JSON.parse(raw) : [];
  } catch { return []; }
}
function saveLog(log: LoggedMeal[]) {
  localStorage.setItem('mct_log_' + TODAY, JSON.stringify(log));
}
function addToLog(meal: LoggedMeal) {
  const log = getLog();
  log.push(meal);
  saveLog(log);
}
function getDailyTotals() {
  return getLog().reduce((acc, m) => ({
    calories: acc.calories + m.calories,
    protein:  acc.protein  + m.protein,
    carbs:    acc.carbs    + m.carbs,
    fat:      acc.fat      + m.fat,
  }), { calories: 0, protein: 0, carbs: 0, fat: 0 });
}

// ── DOM refs ───────────────────────────────────────────────────────────────
const uploadZone     = document.getElementById('upload-zone')!;
const imagePreview   = document.getElementById('image-preview')!;
const previewImg     = document.getElementById('preview-img') as HTMLImageElement;
const uploadPrompt   = document.getElementById('upload-prompt')!;
const removeBtn      = document.getElementById('remove-image')!;
const emptyState     = document.getElementById('empty-state')!;
const loadingState   = document.getElementById('loading-state')!;
const resultsContent = document.getElementById('results-content')!;
const profileQuick   = document.getElementById('profile-quick')!;
const quickAge       = document.getElementById('quick-age') as HTMLInputElement;
const quickWeight    = document.getElementById('quick-weight') as HTMLInputElement;
const quickGoal      = document.getElementById('quick-goal') as HTMLSelectElement;
const quickMeals     = document.getElementById('quick-meals') as HTMLSelectElement;
const dishNameInput  = document.getElementById('dish-name') as HTMLInputElement;
const mwUnitToggle   = document.getElementById('mw-unit-toggle')!;
const mwUnitG        = document.getElementById('mw-unit-g') as HTMLButtonElement;
const mwUnitMl       = document.getElementById('mw-unit-ml') as HTMLButtonElement;
const mwUnitLabel    = document.getElementById('mw-unit-label')!;
const qwUnitKg       = document.getElementById('qw-unit-kg') as HTMLButtonElement;
const qwUnitLbs      = document.getElementById('qw-unit-lbs') as HTMLButtonElement;

let mealWeightUnit: 'g' | 'ml' = 'g';
const LIQUID_KEYWORDS = ['soup','smoothie','dal','kheer','milk','shake','juice','broth','tea','coffee','lassi','buttermilk','protein shake','milkshake','yogurt','curd','pudding','custard','gravy'];
function isLiquidDish(name: string): boolean {
  const lower = name.toLowerCase().trim();
  return LIQUID_KEYWORDS.some(k => lower.includes(k));
}

// ── Meal weight unit toggle (grams/ml for liquids) ───────────────────────
function setMealWeightUnit(unit: 'g' | 'ml') {
  mealWeightUnit = unit;
  if (unit === 'ml') {
    mwUnitG.className = 'px-1.5 py-0.5 text-[#888888] hover:text-[#171717] transition-colors';
    mwUnitMl.className = 'px-1.5 py-0.5 bg-[#171717] text-white transition-colors';
    mwUnitLabel.textContent = 'millilitres (ml)';
  } else {
    mwUnitG.className = 'px-1.5 py-0.5 bg-[#171717] text-white transition-colors';
    mwUnitMl.className = 'px-1.5 py-0.5 text-[#888888] hover:text-[#171717] transition-colors';
    mwUnitLabel.textContent = 'grams';
  }
}

mwUnitG.addEventListener('click', () => setMealWeightUnit('g'));
mwUnitMl.addEventListener('click', () => setMealWeightUnit('ml'));

// Liquid detection — auto-suggest ml for liquid dishes
dishNameInput.addEventListener('input', () => {
  if (isLiquidDish(dishNameInput.value) && mealWeightUnit === 'g') {
    setMealWeightUnit('ml');
  } else if (!isLiquidDish(dishNameInput.value) && mealWeightUnit === 'ml') {
    setMealWeightUnit('g');
  }
});

// ── Profile check — hide quick-fill if already saved ───────────────────────
const hasProfile = savedProfile.age && savedProfile.weight && savedProfile.goal;
if (hasProfile) {
  profileQuick.classList.add('hidden');
} else {
  if (savedProfile.age) quickAge.value = savedProfile.age;
  if (savedProfile.weight) quickWeight.value = savedProfile.weight;
  if (savedProfile.goal) quickGoal.value = savedProfile.goal;
  if (savedProfile.mealsPerDay) quickMeals.value = savedProfile.mealsPerDay;
  MEALS_PER_DAY = parseInt(savedProfile.mealsPerDay) || 3;
}

// Auto-save quick-fill profile on input change
function saveQuickProfile() {
  const data = loadProfile();
  data.age = quickAge.value;
  const unit = data.weightUnit || 'kg';
  const raw = parseFloat(quickWeight.value) || 0;
  data.weight = unit === 'lbs' && raw > 0 ? String(Math.round((raw / 2.20462) * 10) / 10) : String(raw);
  data.goal = quickGoal.value;
  data.mealsPerDay = quickMeals.value;
  localStorage.setItem('mct_profile', JSON.stringify(data));
  MEALS_PER_DAY = parseInt(quickMeals.value) || 3;
}
quickAge.addEventListener('input', saveQuickProfile);
quickWeight.addEventListener('input', saveQuickProfile);
quickGoal.addEventListener('change', saveQuickProfile);
quickMeals.addEventListener('change', saveQuickProfile);

// ── Quick weight unit toggle ─────────────────────────────────────────────
function setQuickWeightUnit(unit: 'kg' | 'lbs') {
  const qp = loadProfile();
  const kgVal = parseFloat(qp.weight) || 0;
  qp.weightUnit = unit;
  localStorage.setItem('mct_profile', JSON.stringify(qp));
  if (unit === 'lbs') {
    quickWeight.placeholder = '154';
    quickWeight.value = kgVal > 0 ? (kgVal * 2.20462).toFixed(1) : '';
    qwUnitKg.className = 'px-1.5 py-0.5 text-[#888888] hover:text-[#171717] transition-colors';
    qwUnitLbs.className = 'px-1.5 py-0.5 bg-[#171717] text-white transition-colors';
  } else {
    quickWeight.placeholder = '70';
    quickWeight.value = kgVal > 0 ? kgVal.toFixed(1) : '';
    qwUnitKg.className = 'px-1.5 py-0.5 bg-[#171717] text-white transition-colors';
    qwUnitLbs.className = 'px-1.5 py-0.5 text-[#888888] hover:text-[#171717] transition-colors';
  }
}

qwUnitKg.addEventListener('click', () => setQuickWeightUnit('kg'));
qwUnitLbs.addEventListener('click', () => setQuickWeightUnit('lbs'));

// Restore quick weight unit from profile
const qwInitProfile = loadProfile();
if (qwInitProfile.weightUnit === 'lbs') setQuickWeightUnit('lbs');

// ── Upload handling ────────────────────────────────────────────────────────
let selectedFile: File | null = null;
const uploadError = document.getElementById('upload-error')!;
const cameraInput = document.getElementById('camera-input') as HTMLInputElement;
const galleryInput = document.getElementById('gallery-input') as HTMLInputElement;
const cameraBtn = document.getElementById('camera-btn')!;
const galleryBtn = document.getElementById('gallery-btn')!;
const analyseBtn = document.getElementById('analyse-btn') as HTMLButtonElement;
const analyseText = document.getElementById('analyse-text')!;
const analyseIcon = document.getElementById('analyse-icon')!;

function showError(msg: string) {
  uploadError.textContent = msg;
  uploadError.classList.remove('hidden');
  setTimeout(() => uploadError.classList.add('hidden'), 5000);
}

const ALLOWED_TYPES = ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'];
function isValidImageType(type: string): boolean {
  return ALLOWED_TYPES.includes(type) || type.startsWith('image/');
}

function showPreview(file: File) {
  if (!isValidImageType(file.type)) {
    showError('Unsupported file type. Please use JPG, PNG, or WEBP.');
    return;
  }
  if (file.size > 10 * 1024 * 1024) {
    showError('File too large. Maximum size is 10 MB.');
    return;
  }
  selectedFile = file;
  previewImg.src = URL.createObjectURL(file);
  uploadPrompt.classList.add('hidden');
  imagePreview.classList.remove('hidden');
  analyseBtn.disabled = false;
}

