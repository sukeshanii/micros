// Default fallback for unknown dishes
const DEFAULT_DISH = { ingredients: ['Mixed Ingredients','Vegetables','Oil','Salt','Spices','Herbs'], calPer100: 150, proteinPer100: 8, carbsPer100: 20, fatPer100: 5, fiberPer100: 1.5 };

function matchDish(dishName: string): typeof DEFAULT_DISH {
  if (!dishName) return DEFAULT_DISH;
  const lower = dishName.toLowerCase().trim();

  // Exact match — instant win
  if (DISH_DB[lower]) return DISH_DB[lower];

  const keys = Object.keys(DISH_DB);
  const words = lower.split(/\s+/).filter(w => w.length >= 2);

  let bestScore = 0;
  let bestKey = '';

  for (const key of keys) {
    let score = 0;
    const keyWords = key.split(/\s+/);

    // Award points for each input word that appears in the key
    for (const w of words) {
      if (key.includes(w)) score += 10;
      if (key === w) score += 15;           // exact word match bonus
      for (const kw of keyWords) {
        if (kw.includes(w) || w.includes(kw)) score += 5;
      }
    }

    // Bonus: key contains the full input (user typed a sub-string of a dish name)
    if (key.includes(lower)) score += 8;
    // Bonus: every key-word matched at least once
    const matchedAllKeyWords = keyWords.every(kw =>
      kw.length < 3 || words.some(w => kw.includes(w) || w.includes(kw))
    );
    if (matchedAllKeyWords) score += 6;

    // Longer, more specific dish names get a small boost as a tiebreaker
    score += key.length * 0.5;

    if (score > bestScore) {
      bestScore = score;
      bestKey = key;
    }
  }

  return bestScore >= 10 ? DISH_DB[bestKey] : DEFAULT_DISH;
}

// ── Mock AI result ─────────────────────────────────────────────────────────
function getMockResult(dishName: string, weight: number, age: number, userWeight: number, goal: string): NutritionResult {
  const dish = matchDish(dishName);
  const s = weight / 100;
  const calories = Math.round(dish.calPer100 * s);
  const protein  = Math.round(dish.proteinPer100 * s);
  const carbs    = Math.round(dish.carbsPer100 * s);
  const fat      = Math.round(dish.fatPer100 * s);
  const fiber    = Math.round(dish.fiberPer100 * s);

  const pt = PER_MEAL_TARGETS;
  const dt = DAILY_TARGETS;
  const sugg: string[] = [];
  const calPct = Math.round((calories - pt.calories) / pt.calories * 100);
  const proPct = Math.round((protein - pt.protein) / pt.protein * 100);
  const carbPct = Math.round((carbs - pt.carbs) / pt.carbs * 100);
  const fatPct = Math.round((fat - pt.fat) / pt.fat * 100);
  const calDir = calPct > 0 ? 'above' : calPct < 0 ? 'below' : 'at';
  const proDir = proPct > 0 ? 'above' : proPct < 0 ? 'below' : 'at';
  const intro = HAS_PROFILE
    ? `Based on your profile, your target is ${pt.calories} kcal, ${pt.protein}g protein, ${pt.carbs}g carbs, and ${pt.fat}g fat per meal.`
    : `Your target is ${pt.calories} kcal, ${pt.protein}g protein, ${pt.carbs}g carbs, and ${pt.fat}g fat per meal.`;
  sugg.push(
    `${intro} ` +
    `This meal provides ${calories} kcal and ${protein}g protein. ` +
    `Calories are ${calDir} target by ${Math.abs(calPct)}% while protein is ${proDir} target by ${Math.abs(proPct)}%.`
  );
  if (calPct > 15) sugg.push('Calories are significantly above your per-meal target. Consider reducing portion size or choosing lighter ingredients.');
  if (proPct < -15) sugg.push('Protein is well below your per-meal target. Add a lean protein source like chicken, tofu, or lentils.');
  if (proPct > 20) sugg.push('Great protein intake! This helps with satiety and muscle maintenance.');
  if (carbPct > 20) sugg.push('Carbs are above your target. Consider swapping refined carbs for whole grains or vegetables.');
  if (fatPct > 20) sugg.push('Fat is above your target. Try reducing oil, butter, or creamy sauces.');
  if (fiber < 8) sugg.push('Include leafy greens or legumes to boost fibre intake.');
  if (sugg.length < 2) sugg.push('Overall a balanced meal. Keep up the good habits!');

  // Next meal ideas — diverse pool selected by dish name hash for variety
  function pickNextMeals(goal: string, dishName: string) {
    const pool = goal === 'lose' ? [
      { name: 'Grilled Salmon Salad', emoji: '🥗', cal: 320, reason: 'High protein, low carb' },
      { name: 'Lentil Soup',          emoji: '🍲', cal: 280, reason: 'Rich in fibre & iron' },
      { name: 'Greek Yogurt Bowl',    emoji: '🥣', cal: 210, reason: 'Probiotic + calcium boost' },
      { name: 'Zucchini Noodles',     emoji: '🥬', cal: 180, reason: 'Low-calorie, nutrient dense' },
      { name: 'Grilled Fish Tacos',   emoji: '🌮', cal: 290, reason: 'Lean protein + healthy fats' },
      { name: 'Cauliflower Rice Bowl',emoji: '🍛', cal: 230, reason: 'Low carb, high volume' },
      { name: 'Turkey Lettuce Wraps', emoji: '🥬', cal: 260, reason: 'Light yet filling protein' },
      { name: 'Miso Soup with Tofu',  emoji: '🍜', cal: 150, reason: 'Low calorie, warming' },
    ] : goal === 'gain' ? [
      { name: 'Chicken & Rice Bowl',  emoji: '🍚', cal: 620, reason: 'High protein + complex carbs' },
      { name: 'Peanut Butter Toast',  emoji: '🥜', cal: 420, reason: 'Healthy fats + energy' },
      { name: 'Egg & Avocado Wrap',   emoji: '🌯', cal: 480, reason: 'Complete amino acids' },
      { name: 'Steak & Sweet Potato', emoji: '🥩', cal: 650, reason: 'Iron-rich muscle builder' },
      { name: 'Protein Oatmeal Bowl', emoji: '🥣', cal: 450, reason: 'Slow-release energy' },
      { name: 'Tuna Pasta Bake',      emoji: '🍝', cal: 580, reason: 'Carbs + protein dense' },
      { name: 'Trail Mix & Banana',   emoji: '🥜', cal: 380, reason: 'Quick calorie + energy boost' },
      { name: 'Chickpea Curry & Rice',emoji: '🍛', cal: 520, reason: 'Plant-based protein + carbs' },
    ] : [
      { name: 'Veggie Stir Fry',      emoji: '🥦', cal: 350, reason: 'Micronutrient dense' },
      { name: 'Quinoa Buddha Bowl',   emoji: '🫙', cal: 410, reason: 'Complete protein + fibre' },
      { name: 'Fruit & Nut Snack',    emoji: '🍎', cal: 180, reason: 'Natural sugars + antioxidants' },
      { name: 'Hummus & Veggie Plate',emoji: '🫘', cal: 310, reason: 'Plant protein + healthy fats' },
      { name: 'Grilled Chicken Wrap', emoji: '🌯', cal: 380, reason: 'Balanced macros' },
      { name: 'Berry Smoothie Bowl',  emoji: '🥤', cal: 290, reason: 'Antioxidants + fibre' },
      { name: 'Shakshuka',            emoji: '🍳', cal: 320, reason: 'Protein-rich, nutrient dense' },
      { name: 'Stuffed Bell Peppers', emoji: '🫑', cal: 360, reason: 'Colourful nutrient variety' },
    ];
    const seed = dishName.split('').reduce((a, c) => a + c.charCodeAt(0), 0) + new Date().getDate();
    const start = seed % pool.length;
    return [...pool.slice(start), ...pool.slice(0, start)].slice(0, 3);
  }
  const nextMeals = pickNextMeals(goal, dishName);

  return {
    mealName: dishName || 'Mixed meal', weight, calories,
    macros: { protein, carbs, fat, fiber },
    micros: {
      'Vitamin A':  { val: Math.round(180*s/3.5),          unit: 'µg', ref: 800  },
      'Vitamin C':  { val: Math.round(12*s/3.5),            unit: 'mg', ref: 80   },
      'Vitamin D':  { val: Math.round(1.2*s/3.5*10)/10,     unit: 'µg', ref: 15   },
      'Vitamin E':  { val: Math.round(2.4*s/3.5*10)/10,     unit: 'mg', ref: 12   },
      'Vitamin K':  { val: Math.round(18*s/3.5),            unit: 'µg', ref: 75   },
      'Vitamin B12':{ val: Math.round(0.6*s/3.5*10)/10,     unit: 'µg', ref: 2.4  },
      'Folate':     { val: Math.round(32*s/3.5),            unit: 'µg', ref: 200  },
      'Iron':       { val: Math.round(3.2*s/3.5*10)/10,     unit: 'mg', ref: 14   },
      'Calcium':    { val: Math.round(95*s/3.5),            unit: 'mg', ref: 800  },
      'Potassium':  { val: Math.round(420*s/3.5),           unit: 'mg', ref: 2000 },
      'Sodium':     { val: Math.round(680*s/3.5),           unit: 'mg', ref: 2300 },
      'Zinc':       { val: Math.round(2.1*s/3.5*10)/10,     unit: 'mg', ref: 10   },
      'Magnesium':  { val: Math.round(38*s/3.5),            unit: 'mg', ref: 375  },
    },
    ingredients: dish.ingredients,
    suggestions: sugg,
    nextMeals,
  };
}

// ── Render daily progress (uses running log totals) ────────────────────────
function renderDailyProgress() {
  const totals = getDailyTotals();
  const t = DAILY_TARGETS;
  const log = getLog();
  const mealsLogged = log.length;
  const rows = [
    { label: 'Daily Calories', val: totals.calories, goal: t.calories, unit: 'kcal', color: calColor() },
    { label: 'Daily Protein',  val: totals.protein,  goal: t.protein,  unit: 'g',    color: '#3b82f6' },
    { label: 'Carbs',    val: totals.carbs,    goal: t.carbs,    unit: 'g',    color: '#f59e0b' },
    { label: 'Fat',      val: totals.fat,      goal: t.fat,      unit: 'g',    color: '#ef4444' },
  ];
  let html = rows.map(r => {
    const pct = Math.min(Math.round(r.val / r.goal * 100), 100);
    const over = r.val > r.goal;
    return `
      <div>
        <div class="flex justify-between text-[12px] mb-1">
          <span class="text-[#4d4d4d]">${r.label}</span>
          <span class="font-mono ${over ? 'text-[#ee0000]' : 'text-[#888888]'}">${r.val}${r.unit} / ${r.goal}${r.unit}${over ? ' ⚠' : ''}</span>
        </div>
        <div class="h-1.5 rounded-full bg-[#ebebeb] overflow-hidden">
          <div class="h-full rounded-full transition-all duration-1000" style="width:${pct}%;background:${over ? '#ee0000' : r.color}"></div>
        </div>
      </div>`;
  }).join('');

  // Meals logged counter
  const mealsPct = Math.min(Math.round(mealsLogged / MEALS_PER_DAY * 100), 100);
  html += `
    <div class="pt-3 border-t border-[#ebebeb]">
      <div class="flex justify-between text-[12px] mb-1">
        <span class="text-[#4d4d4d]">Meals Logged</span>
        <span class="font-mono text-[#888888]">${mealsLogged} / ${MEALS_PER_DAY}</span>
      </div>
      <div class="h-1.5 rounded-full bg-[#ebebeb] overflow-hidden">
        <div class="h-full rounded-full transition-all duration-1000" style="width:${mealsPct}%;background:${mealsLogged >= MEALS_PER_DAY ? '#10b981' : '#50e3c2'}"></div>
      </div>
    </div>`;
  document.getElementById('daily-progress')!.innerHTML = html;

  // Remaining section
  const remaining = {
    calories: Math.max(0, t.calories - totals.calories),
    protein: Math.max(0, t.protein - totals.protein),
    carbs: Math.max(0, t.carbs - totals.carbs),
    fat: Math.max(0, t.fat - totals.fat),
  };
  const remainingSection = document.getElementById('remaining-section')!;
  if (totals.calories > 0 && t.calories > 0) {
    remainingSection.classList.remove('hidden');
    document.getElementById('remaining-grid')!.innerHTML = [
      { label: 'Calories left', val: remaining.calories, unit: 'kcal', color: calColor() },
      { label: 'Protein left',  val: remaining.protein,  unit: 'g',    color: '#3b82f6' },
      { label: 'Carbs left',    val: remaining.carbs,    unit: 'g',    color: '#f59e0b' },
      { label: 'Fat left',      val: remaining.fat,      unit: 'g',    color: '#ef4444' },
    ].map(s => `
      <div class="rounded-[8px] bg-[#fafafa] border border-[#ebebeb] p-3 text-center">
        <p class="text-[20px] font-semibold tracking-[-0.6px]" style="color:${s.color}">${s.val}</p>
        <p class="text-[10px] text-[#888888] mt-0.5">${s.label} (${s.unit})</p>
      </div>`).join('');
  } else {
    remainingSection.classList.add('hidden');
  }
}

// ── Meal type — always 'meal' ──────────────────────────────────────────────
const selectedMealType = 'meal';

// ── Render meals timeline ──────────────────────────────────────────────────
function renderTimeline() {
  const log = getLog();
  const dateEl = document.getElementById('timeline-date');
  const totalCalEl = document.getElementById('timeline-total-cal');
  const listEl = document.getElementById('meals-timeline')!;
  const emptyEl = document.getElementById('meals-timeline-empty')!;
  const summaryBar = document.getElementById('day-summary-bar')!;
  const summaryMacros = document.getElementById('day-summary-macros')!;

  if (dateEl) dateEl.textContent = new Date().toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long' });

  if (log.length === 0) {
    listEl.innerHTML = '';
    emptyEl.classList.remove('hidden');
    summaryBar.classList.add('hidden');
    if (totalCalEl) totalCalEl.textContent = '';
    return;
  }

  emptyEl.classList.add('hidden');
  summaryBar.classList.remove('hidden');

  const totals = getDailyTotals();
  if (totalCalEl) totalCalEl.textContent = `${totals.calories} kcal total`;

  let html = '';
  log.forEach(m => {
    html += `
      <div class="px-5 py-3 flex items-center gap-4 hover:bg-[#fafafa] transition-colors">
        <div class="w-8 h-8 rounded-full bg-[#fafafa] border border-[#ebebeb] flex items-center justify-center text-[10px] font-mono font-medium shrink-0 text-[#888888]">
          ${m.time}
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-[13px] font-medium text-[#171717] truncate">${m.name}</p>
        </div>
        <div class="hidden sm:flex items-center gap-3 text-[11px] font-mono text-[#888888] shrink-0">
          <span><strong class="text-[#3b82f6]">${m.protein}g</strong> P</span>
          <span><strong class="text-[#f59e0b]">${m.carbs}g</strong> C</span>
          <span><strong class="text-[#ef4444]">${m.fat}g</strong> F</span>
        </div>
        <div class="text-right shrink-0">
          <p class="text-[14px] font-semibold text-[#171717]">${m.calories}</p>
          <p class="text-[10px] text-[#888888]">kcal</p>
        </div>
      </div>`;
  });

  listEl.innerHTML = html;

  // Day summary macros
  const summaryItems = [
    { label: 'Calories', val: totals.calories, unit: 'kcal', color: calColor() },
    { label: 'Protein',  val: totals.protein,  unit: 'g',    color: '#3b82f6' },
    { label: 'Carbs',    val: totals.carbs,    unit: 'g',    color: '#f59e0b' },
    { label: 'Fat',      val: totals.fat,      unit: 'g',    color: '#ef4444' },
  ];
  summaryMacros.innerHTML = summaryItems.map(s => `
    <div class="text-center">
      <p class="text-[16px] font-semibold tracking-[-0.5px]" style="color:${s.color}">${s.val}</p>
      <p class="text-[10px] text-[#888888] mt-0.5">${s.label} (${s.unit})</p>
    </div>
  `).join('');
}

// Initial renders — wait for targets to load from server first
(async () => {
  await loadTargets();
  renderTimeline();
  renderDailyProgress();
})();

// ── Meal Analysis: Estimated / Target / Difference / Percentage ────────────
function renderMealAnalysis(result: NutritionResult) {
  const target = PER_MEAL_TARGETS;
  const compEl = document.getElementById('per-meal-comparison')!;
  compEl.classList.remove('hidden');
  const refLabel = document.getElementById('comparison-ref-label')!;
  refLabel.textContent = HAS_PROFILE ? 'Compared with your personalized daily target' : 'Compared with standard daily nutrition recommendations';

  function diffRow(label: string, actual: number, tgt: number, unit: string, color: string, isInverse = false) {
    const diff = actual - tgt;
    const sign = diff >= 0 ? '+' : '';
    const pct = tgt > 0 ? Math.round(diff / tgt * 100) : 0;
    const pctSign = diff >= 0 ? '+' : '';
    const diffColor = isInverse
      ? (diff > 0 ? '#ee0000' : diff < 0 ? '#10b981' : '#888888')
      : (diff > 10 ? '#ee0000' : diff < -10 ? '#f5a623' : '#10b981');
    return `
      <div class="flex items-center justify-between py-1.5 border-b border-[#ebebeb]/50 last:border-b-0">
        <span class="text-[12px] text-[#4d4d4d]">${label}</span>
        <div class="text-right">
          <span class="text-[13px] font-semibold" style="color:${color}">${actual}${unit}</span>
          <span class="text-[11px] text-[#888888]"> / ${tgt}${unit}</span>
          <br>
          <span class="text-[11px] font-mono" style="color:${diffColor}">${sign}${diff} ${unit} (${pctSign}${pct}%)</span>
        </div>
      </div>`;
  }

  document.getElementById('comparison-grid')!.innerHTML = `
    <div class="rounded-[8px] bg-[#fafafa] border border-[#ebebeb] p-4">
      <p class="text-[10px] font-mono text-[#888888] uppercase tracking-wide mb-2">Estimated</p>
      <div class="space-y-1.5">
        <div class="flex justify-between text-[13px]"><span class="text-[#4d4d4d]">Calories</span><span class="font-semibold text-[#171717]">${result.calories} kcal</span></div>
        <div class="flex justify-between text-[13px]"><span class="text-[#4d4d4d]">Protein</span><span class="font-semibold text-[#3b82f6]">${result.macros.protein}g</span></div>
        <div class="flex justify-between text-[13px]"><span class="text-[#4d4d4d]">Carbs</span><span class="font-semibold text-[#f59e0b]">${result.macros.carbs}g</span></div>
        <div class="flex justify-between text-[13px]"><span class="text-[#4d4d4d]">Fat</span><span class="font-semibold text-[#ef4444]">${result.macros.fat}g</span></div>
      </div>
    </div>
    <div class="rounded-[8px] bg-[#fafafa] border border-[#ebebeb] p-4">
      <p class="text-[10px] font-mono text-[#888888] uppercase tracking-wide mb-2">Per-Meal Target</p>
      <div class="space-y-1.5">
        <div class="flex justify-between text-[13px]"><span class="text-[#4d4d4d]">Calories</span><span class="font-semibold text-[#171717]">${target.calories} kcal</span></div>
        <div class="flex justify-between text-[13px]"><span class="text-[#4d4d4d]">Protein</span><span class="font-semibold text-[#3b82f6]">${target.protein}g</span></div>
        <div class="flex justify-between text-[13px]"><span class="text-[#4d4d4d]">Carbs</span><span class="font-semibold text-[#f59e0b]">${target.carbs}g</span></div>
        <div class="flex justify-between text-[13px]"><span class="text-[#4d4d4d]">Fat</span><span class="font-semibold text-[#ef4444]">${target.fat}g</span></div>
      </div>
    </div>
    <div class="rounded-[8px] bg-[#fafafa] border border-[#ebebeb] p-4">
      <p class="text-[10px] font-mono text-[#888888] uppercase tracking-wide mb-2">Difference</p>
      ${diffRow('Calories', result.calories, target.calories, 'kcal', calColor())}
      ${diffRow('Protein', result.macros.protein, target.protein, 'g', '#3b82f6')}
      ${diffRow('Carbs', result.macros.carbs, target.carbs, 'g', '#f59e0b')}
      ${diffRow('Fat', result.macros.fat, target.fat, 'g', '#ef4444')}
    </div>`;
}

// ── Analyse ────────────────────────────────────────────────────────────────
analyseBtn.addEventListener('click', async () => {
  const dishName   = (document.getElementById('dish-name') as HTMLInputElement).value.trim();
  const mealWeightInput = document.getElementById('meal-weight') as HTMLInputElement;
  const rawWeight = mealWeightInput.value.trim();
  if (!rawWeight) {
    showError('Please enter an approximate weight before analysis.');
    mealWeightInput.focus();
    return;
  }
  const mealWeight = parseInt(rawWeight) || 0;
  if (mealWeight <= 0) {
    showError('Please enter a valid weight greater than zero.');
    mealWeightInput.focus();
    return;
  }
  const age        = parseInt(quickAge.value) || parseInt(savedProfile.age) || 25;
  const qwRaw = parseFloat(quickWeight.value) || 0;
  const qwProfile = loadProfile();
  const userWeight = Math.round(qwProfile.weightUnit === 'lbs' && qwRaw > 0 ? qwRaw / 2.20462 : qwRaw) || parseInt(savedProfile.weight) || 70;
  const goal       = quickGoal.value || savedProfile.goal || 'maintain';

  // Create guest session if needed
  if (!GUEST_TOKEN) {
    const mpd = parseInt(quickMeals.value) || parseInt(savedProfile.mealsPerDay) || 3;
    const gGoal = quickGoal.value || savedProfile.goal || 'maintain';
    try {
      const r = await fetch('/api/guest', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ mealsPerDay: mpd, goal: gGoal }),
      });
      if (r.ok) {
        const data = await r.json();
        GUEST_TOKEN = data.token;
        localStorage.setItem('mct_guest_token', GUEST_TOKEN);
      }
    } catch {}
  }

  emptyState.classList.add('hidden');
  resultsContent.classList.add('hidden');
  loadingState.classList.remove('hidden');

  analyseBtn.disabled = true;
  analyseText.textContent = 'Analysing meal...';
  analyseIcon.innerHTML = '<circle cx="8" cy="8" r="6" stroke="white" stroke-width="1.3" fill="none" stroke-dasharray="30 10"><animateTransform attributeName="transform" type="rotate" from="0 8 8" to="360 8 8" dur="1s" repeatCount="indefinite"/></circle>';

  // Try server analysis first
  let result: NutritionResult | null = null;
  try {
    const formData = new FormData();
    formData.append('dishName', dishName);
    formData.append('weight', mealWeight.toString());
    formData.append('age', age.toString());
    formData.append('userWeight', userWeight.toString());
    formData.append('goal', goal);
    if (GUEST_TOKEN) {
      formData.append('guestToken', GUEST_TOKEN);
    }
    if (selectedFile) {
      formData.append('image', selectedFile);
    }

    const r = await fetch('/api/analyze', {
      method: 'POST',
      body: formData,
    });
    if (r.ok) {
      result = await r.json();
      if (result.perMealTarget) {
        HAS_PROFILE = result.hasProfile === true;
        PER_MEAL_TARGETS = result.perMealTarget;
        DAILY_TARGETS = result.dailyTarget;
        MEALS_PER_DAY = result.mealsPerDay;
      }
    }
  } catch {}

  // Fall back to local analysis if server fails
  if (!result) {
    await new Promise(r => setTimeout(r, 1500));
    result = getMockResult(dishName, mealWeight, age, userWeight, goal);
  }

  analyseBtn.disabled = false;
  analyseText.textContent = 'Analyse meal';
  analyseIcon.innerHTML = '<circle cx="8" cy="8" r="6" stroke="white" stroke-width="1.3" fill="none"/><path d="M5 8l2 2 4-4" stroke="white" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>';

  // Log this meal to daily tracker (localStorage)
  addToLog({
    name: result.mealName,
    calories: result.calories,
    protein: result.macros.protein,
    carbs: result.macros.carbs,
    fat: result.macros.fat,
    time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
  });

  // Sync meal to server
  const today = new Date().toISOString().slice(0, 10);
  try {
    await fetch('/api/meals', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        guestToken: GUEST_TOKEN,
        mealDate: today,
        mealNumber: getLog().length,
        mealType: 'meal',
        mealName: result.mealName,
        weightGrams: result.weight,
        calories: result.calories,
        protein: result.macros.protein,
        carbs: result.macros.carbs,
        fat: result.macros.fat,
        fiber: result.macros.fiber,
      }),
    });
  } catch {}

  // ── Meal header ──
  document.getElementById('result-meal-name')!.textContent = result.mealName;
  const weightLabel = mealWeightUnit === 'ml' ? 'ml' : 'g';
  document.getElementById('result-weight')!.textContent    = `~${result.weight}${weightLabel} serving`;
  document.getElementById('result-calories')!.textContent  = result.calories.toString();

  // ── Meal Analysis: Estimated / Target / Difference ──
  renderMealAnalysis(result);

  // ── Update nutrition report labels for personalized targets ──
  if (HAS_PROFILE) {
    document.getElementById('nreport-ref-label')!.textContent = 'Compared with your personalized daily target';
    document.getElementById('nreport-ref-col')!.textContent = 'Your target';
  } else {
    document.getElementById('nreport-ref-label')!.textContent = 'Compared with standard daily nutrition recommendations';
    document.getElementById('nreport-ref-col')!.textContent = 'Daily ref.';
  }

  // ── Nutrition report table — Macros tab (use personal targets if profile exists) ──
  const macroRef = HAS_PROFILE ? {
    'Energy':   { ref: DAILY_TARGETS.calories, unit: 'kcal' },
    'Protein':  { ref: DAILY_TARGETS.protein,  unit: 'g' },
    'Carbs':    { ref: DAILY_TARGETS.carbs,    unit: 'g' },
    'Fat':      { ref: DAILY_TARGETS.fat,      unit: 'g' },
    'Fibre':    { ref: 25,                     unit: 'g' },
    'Sugar':    { ref: 90,                     unit: 'g' },
    'Sat. Fat': { ref: 20,                     unit: 'g' },
  } : {
    'Energy':   { ref: 2000, unit: 'kcal' },
    'Protein':  { ref: 100,  unit: 'g' },
    'Carbs':    { ref: 250,  unit: 'g' },
    'Fat':      { ref: 65,   unit: 'g' },
    'Fibre':    { ref: 25,   unit: 'g' },
    'Sugar':    { ref: 90,   unit: 'g' },
    'Sat. Fat': { ref: 20,   unit: 'g' },
  };
  const macroRows = [
    tableRow('Energy',   result.calories,        macroRef['Energy'].unit,   macroRef['Energy'].ref),
    tableRow('Protein',  result.macros.protein,  macroRef['Protein'].unit,  macroRef['Protein'].ref),
    tableRow('Carbs',    result.macros.carbs,    macroRef['Carbs'].unit,    macroRef['Carbs'].ref),
    tableRow('Fat',      result.macros.fat,      macroRef['Fat'].unit,      macroRef['Fat'].ref),
    tableRow('Fibre',    result.macros.fiber,    'g',                       25),
    tableRow('Sugar',    Math.round(result.macros.carbs * 0.3), 'g', 90, true),
    tableRow('Sat. Fat', Math.round(result.macros.fat * 0.4),   'g', 20, true),
  ].join('');
  document.getElementById('nutrition-table-macros')!.innerHTML = macroRows;

  // ── Nutrition report table — Micros tab ──
  const microRows = Object.entries(result.micros).map(([name, d]) =>
    tableRow(name, d.val, d.unit, d.ref, name === 'Sodium')
  ).join('');
  document.getElementById('nutrition-table-micros')!.innerHTML = microRows;

  // ── AI suggestions ──
  document.getElementById('suggestions-list')!.innerHTML = result.suggestions.map(s =>
    `<p class="text-[14px] text-[#888888] leading-[20px] flex gap-2"><span class="text-[#50e3c2] shrink-0 mt-0.5">→</span>${s}</p>`
  ).join('');

  // ── Next meal ideas ──
  let nextMeals = result.nextMeals;
  if (!nextMeals || nextMeals.length === 0) {
    const seed = result.mealName.split('').reduce((a: number, c: string) => a + c.charCodeAt(0), 0) + new Date().getDate();
    const pool = goal === 'lose' ? [
      { name: 'Grilled Salmon Salad', emoji: '🥗', cal: 320, reason: 'High protein, low carb' },
      { name: 'Lentil Soup',          emoji: '🍲', cal: 280, reason: 'Rich in fibre & iron' },
      { name: 'Greek Yogurt Bowl',    emoji: '🥣', cal: 210, reason: 'Probiotic + calcium boost' },
      { name: 'Zucchini Noodles',     emoji: '🥬', cal: 180, reason: 'Low-calorie, nutrient dense' },
    ] : goal === 'gain' ? [
      { name: 'Chicken & Rice Bowl',  emoji: '🍚', cal: 620, reason: 'High protein + complex carbs' },
      { name: 'Peanut Butter Toast',  emoji: '🥜', cal: 420, reason: 'Healthy fats + energy' },
      { name: 'Steak & Sweet Potato', emoji: '🥩', cal: 650, reason: 'Iron-rich muscle builder' },
      { name: 'Protein Oatmeal Bowl', emoji: '🥣', cal: 450, reason: 'Slow-release energy' },
    ] : [
      { name: 'Veggie Stir Fry',      emoji: '🥦', cal: 350, reason: 'Micronutrient dense' },
      { name: 'Quinoa Buddha Bowl',   emoji: '🫙', cal: 410, reason: 'Complete protein + fibre' },
      { name: 'Grilled Chicken Wrap', emoji: '🌯', cal: 380, reason: 'Balanced macros' },
      { name: 'Berry Smoothie Bowl',  emoji: '🥤', cal: 290, reason: 'Antioxidants + fibre' },
    ];
    const start = seed % pool.length;
    nextMeals = [...pool.slice(start), ...pool.slice(0, start)].slice(0, 3);
  }
  document.getElementById('next-meal-ideas')!.innerHTML = nextMeals.map((m: any) => `
    <div class="rounded-[8px] bg-white/5 border border-white/10 p-3 hover:bg-white/10 transition-colors cursor-pointer">
      <div class="flex items-center gap-2 mb-1">
        <span class="text-lg">${m.emoji}</span>
        <span class="text-[13px] font-medium text-white">${m.name}</span>
      </div>
      <p class="text-[11px] text-[#888888]">${m.reason}</p>
      <p class="text-[11px] font-mono text-[#50e3c2] mt-1">~${m.cal} kcal</p>
    </div>`).join('');

  // ── Daily running total ──
  const log = getLog();
  document.getElementById('meals-logged-count')!.textContent = `${log.length} meal${log.length !== 1 ? 's' : ''} logged today`;
  renderDailyProgress();

  // ── Update timeline ──
  renderTimeline();

  loadingState.classList.add('hidden');
  resultsContent.classList.remove('hidden');

  if (window.innerWidth < 1024) {
    document.getElementById('results-panel')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
});

// ── Auto-scroll to scanner on hash ─────────────────────────────────────────
if (window.location.hash === '#scanner') {
  setTimeout(() => {
    document.getElementById('scanner')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }, 300);
}

// ── Browser compatibility: handle private browsing localStorage ────────────
try {
  const testKey = '_mct_test';
  localStorage.setItem(testKey, '1');
  localStorage.removeItem(testKey);
} catch {
  // localStorage unavailable (private browsing) — use in-memory fallback
  const memStore = new Map<string, string>();
  const origGetItem = localStorage.getItem.bind(localStorage);
  const origSetItem = localStorage.setItem.bind(localStorage);
  const origRemoveItem = localStorage.removeItem.bind(localStorage);
  localStorage.getItem = (key: string) => memStore.get(key) ?? origGetItem(key);
  localStorage.setItem = (key: string, val: string) => { memStore.set(key, val); try { origSetItem(key, val); } catch {} };
  localStorage.removeItem = (key: string) => { memStore.delete(key); try { origRemoveItem(key); } catch {} };
}
</script>

