<script>
// ── Types ──────────────────────────────────────────────────────────────────
interface MacroData { protein: number; carbs: number; fat: number; fiber: number; }
interface NutritionResult {
  mealName: string; weight: number; calories: number;
  macros: MacroData;
  micros: Record<string, { val: number; unit: string; ref: number }>;
  ingredients: string[];
  suggestions: string[];
  nextMeals: { name: string; emoji: string; cal: number; reason: string }[];
}
interface LoggedMeal { name: string; calories: number; protein: number; carbs: number; fat: number; time: string; mealType: string; ingredients: string[]; }

type MealType = 'breakfast' | 'lunch' | 'snack' | 'dinner' | 'dessert';
const MEAL_TYPE_META: Record<MealType, { label: string; emoji: string; color: string }> = {
  breakfast: { label: 'Breakfast', emoji: '🌅', color: '#f59e0b' },
  lunch:    { label: 'Lunch',     emoji: '☀️', color: '#3b82f6' },
  snack:    { label: 'Evening Snack', emoji: '🍵', color: '#10b981' },
  dinner:   { label: 'Dinner',    emoji: '🌙', color: '#8b5cf6' },
  dessert:  { label: 'Dessert',   emoji: '🍰', color: '#ec4899' },
};

// ── Persistent daily log (localStorage) ───────────────────────────────────
const TODAY = new Date().toDateString();
function getLog(): LoggedMeal[] {
  try {
    const raw = localStorage.getItem('mct_log_' + TODAY);
    return raw ? JSON.parse(raw) : [];
  } catch { return []; }
}
function saveLog(log: LoggedMeal[]) {
  localStorage.setItem('mct_log_' + TODAY, JSON.stringify(log));
}
function addToLog(meal: LoggedMeal) {
  const log = getLog();
  log.push(meal);
  saveLog(log);
}
function getDailyTotals() {
  return getLog().reduce((acc, m) => ({
    calories: acc.calories + m.calories,
    protein:  acc.protein  + m.protein,
    carbs:    acc.carbs    + m.carbs,
    fat:      acc.fat      + m.fat,
  }), { calories: 0, protein: 0, carbs: 0, fat: 0 });
}

// ── DOM refs ───────────────────────────────────────────────────────────────
const uploadZone     = document.getElementById('upload-zone')!;
const fileInput      = document.getElementById('file-input') as HTMLInputElement;
const imagePreview   = document.getElementById('image-preview')!;
const previewImg     = document.getElementById('preview-img') as HTMLImageElement;
const uploadPrompt   = document.getElementById('upload-prompt')!;
const removeBtn      = document.getElementById('remove-image')!;
const analyseBtn     = document.getElementById('analyse-btn') as HTMLButtonElement;
const emptyState     = document.getElementById('empty-state')!;
const loadingState   = document.getElementById('loading-state')!;
const resultsContent = document.getElementById('results-content')!;

// ── Upload handling ────────────────────────────────────────────────────────
let selectedFile: File | null = null;
function showPreview(file: File) {
  selectedFile = file;
  previewImg.src = URL.createObjectURL(file);
  uploadPrompt.classList.add('hidden');
  imagePreview.classList.remove('hidden');
}
function clearPreview() {
  selectedFile = null; previewImg.src = '';
  imagePreview.classList.add('hidden');
  uploadPrompt.classList.remove('hidden');
  fileInput.value = '';
}
fileInput.addEventListener('change', () => { if (fileInput.files?.[0]) showPreview(fileInput.files[0]); });
removeBtn.addEventListener('click', (e) => { e.stopPropagation(); clearPreview(); });
uploadZone.addEventListener('dragover', (e) => { e.preventDefault(); uploadZone.classList.add('drag-over'); });
uploadZone.addEventListener('dragleave', () => uploadZone.classList.remove('drag-over'));
uploadZone.addEventListener('drop', (e) => {
  e.preventDefault(); uploadZone.classList.remove('drag-over');
  const f = e.dataTransfer?.files[0];
  if (f?.type.startsWith('image/')) showPreview(f);
});

// ── Tab switcher (exposed globally for onclick) ────────────────────────────
(window as any).switchTab = (tab: 'macros' | 'micros') => {
  const macroTab  = document.getElementById('tab-macros')!;
  const microTab  = document.getElementById('tab-micros')!;
  const macroBody = document.getElementById('nutrition-table-macros')!;
  const microBody = document.getElementById('nutrition-table-micros')!;
  if (tab === 'macros') {
    macroTab.classList.replace('text-[#888888]','text-[#171717]');
    macroTab.classList.replace('border-transparent','border-[#171717]');
    microTab.classList.replace('text-[#171717]','text-[#888888]');
    microTab.classList.replace('border-[#171717]','border-transparent');
    macroBody.classList.remove('hidden'); microBody.classList.add('hidden');
  } else {
    microTab.classList.replace('text-[#888888]','text-[#171717]');
    microTab.classList.replace('border-transparent','border-[#171717]');
    macroTab.classList.replace('text-[#171717]','text-[#888888]');
    macroTab.classList.replace('border-[#171717]','border-transparent');
    microBody.classList.remove('hidden'); macroBody.classList.add('hidden');
  }
};

// ── Reference intakes (WHO / EU NRV) ──────────────────────────────────────
const MACRO_REF = {
  'Energy':  { ref: 2000, unit: 'kcal' },
  'Protein': { ref: 50,   unit: 'g' },
