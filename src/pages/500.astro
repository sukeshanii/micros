---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout title="500 — Server Error | Micro & Calorie Tracker">
  <Navbar />

  <main class="max-w-[600px] mx-auto px-6 py-20 text-center">
    <div class="text-[80px] md:text-[120px] font-semibold tracking-[-4px] text-[#ebebeb] leading-none mb-4">500</div>
    <h1 class="text-[28px] font-semibold tracking-[-1.12px] text-[#171717] mb-3">Something went wrong.</h1>
    <p class="text-[16px] text-[#4d4d4d] leading-[26px] mb-8">An unexpected error occurred. Please try refreshing the page or come back later.</p>
    <div class="flex items-center justify-center gap-3 flex-wrap">
      <a href="/" class="px-5 h-11 rounded-full bg-[#171717] text-white text-[15px] font-medium flex items-center hover:bg-[#333] transition-colors">
        Go home
      </a>
      <a href="/contact" class="px-5 h-11 rounded-full bg-white text-[#171717] text-[15px] font-medium flex items-center border border-[#ebebeb] hover:bg-[#fafafa] transition-colors shadow-card">
        Report issue
      </a>
    </div>
  </main>
</Layout>
